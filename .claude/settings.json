{
  "//": "Committed, shared settings. Personal overrides go in settings.local.json (gitignored). The allow list is deliberately read-only tools plus this repo's own scripts and the two device compilers -- add the project's entry points as you add them. attribution.sessionUrl is false because this repository is PUBLIC: the Claude-Session trailer puts a claude.ai session link into commit messages and PR bodies permanently, and removing one after the fact means rewriting published history. Co-Authored-By is kept.",
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(devtools/devcontainer.sh:*)",
      "Bash(devtools/worktree.sh:*)",
      "Bash(devtools/doctor.sh:*)",
      "Bash(devtools/kernel-tier.sh:*)",
      "Bash(devtools/prepush-tests.sh:*)",
      "Bash(devtools/claude-version.sh:*)",
      "Bash(docker/build.sh:*)",
      "Bash(nvcc:*)",
      "Bash(hipcc:*)",
      "Bash(hipconfig:*)",
      "Bash(nvidia-smi:*)",
      "Bash(rocminfo:*)",
      "Bash(rocm-smi:*)",
      "Bash(clang-format:*)",
      "Bash(cmake:*)",
      "Bash(ninja:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(pre-commit:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(which:*)",
      "Bash(stat:*)",
      "Bash(wc:*)",
      "Bash(pdftotext:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker volume ls:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/session-context.sh\"; [ -f \"$SCRIPT\" ] && bash \"$SCRIPT\" || true",
            "statusMessage": "Reporting host/container + checkout"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/protect-main.py\"; [ -f \"$SCRIPT\" ] && python3 \"$SCRIPT\" || true",
            "statusMessage": "Checking main-checkout guard"
          }
        ]
      }
    ]
  }
}
