# syntax=docker/dockerfile:1.7
# ============================================================================
# combined -- cuda + ROCm in one image
# ============================================================================
# For working on both backends in one shell: generate once, then compile and
# run the same kernel through nvcc on the RTX 3080 and hipcc on the RX 9060 XT
# without leaving the container. That cross-check is the reason this image
# exists -- the two device compilers disagree (hipcc IS clang, nvcc is not),
# and a generated kernel that only one of them accepts is the defect class this
# project is most exposed to.
#
#   docker/build.sh combined   # base, cuda, then this; tags :combined
#
# A DIAMOND ONLY IN INTENT. Docker has no multiple inheritance, so this takes
# `cuda` as its parent and re-runs docker/install-rocm.sh rather than layering
# on the `hip` image -- which is why ROCM_VERSION, GPU_TARGETS and
# ROCM_PACKAGES are declared in BOTH this file and Dockerfile.hip. Bump them
# together; devtools/doctor.sh does not check these two for drift the way it
# does the Claude pin.
ARG PROJECT_NAME=fj
ARG PARENT_IMAGE=${PROJECT_NAME}:cuda
FROM ${PARENT_IMAGE}

ARG ROCM_VERSION=7.2.4
USER root

ARG PROJECT_NAME
LABEL devcontainer.project="${PROJECT_NAME}"

# Must match Dockerfile.hip -- see the header.
ARG GPU_TARGETS=gfx1200
ENV GPU_TARGETS=${GPU_TARGETS} \
    AMDGPU_TARGETS=${GPU_TARGETS} \
    HIP_ARCH=${GPU_TARGETS} \
    ROCM_PATH=/opt/rocm

ARG ROCM_PACKAGES=""
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=bind,source=docker/install-rocm.sh,target=/tmp/install-rocm.sh \
    ROCM_VERSION="${ROCM_VERSION}" GPU_TARGETS="${GPU_TARGETS}" \
    ${ROCM_PACKAGES:+ROCM_PACKAGES="${ROCM_PACKAGES}"} \
    bash /tmp/install-rocm.sh

# /opt/rocm/bin LAST, and here it matters more than in Dockerfile.hip: this
# image has nvcc as well, and nvcc's default host compiler is the first g++ on
# PATH. ROCm's own clang must not displace the system one.
ENV PATH=${PATH}:/opt/rocm/bin

# Claude Code, PINNED. Note install-claude-code.sh runs for the SECOND time in
# this image -- the `cuda` parent already ran it -- which is why its keyring
# step passes `gpg --batch --yes`: a bare dearmor over an existing file prompts,
# opens /dev/tty to do it, and dies in a build that has none.
ARG CLAUDE_CODE_VERSION=2.1.314
ENV CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION}
RUN --mount=type=bind,source=docker/install-claude-code.sh,target=/tmp/install-claude-code.sh \
    bash /tmp/install-claude-code.sh

# The Antigravity CLI (`agy`), PINNED -- the same leaf-layer treatment as
# Claude Code above, declared in all three GPU files and bumped in all three at
# once by `devtools/agy-version.sh --apply`. docker/install-agy.sh carries the
# rest: why not upstream's install.sh, and why the pin is a RELEASE rather than
# a version.
#
# Like install-claude-code.sh above, this runs for the SECOND time in this
# image -- and the binary is 214MB, so a second copy would be a second 214MB
# layer in an image already near 40GB. install-agy.sh INHERITS the parent's
# copy when it is already the pinned release, and reinstalls when it is not, so
# a `combined` that pins something other than its parent still gets its own.
#
# TWO lines to bump, not one: AGY_SHA512 belongs to the exact tarball
# AGY_RELEASE names, and install-agy.sh verifies it rather than recording it.
# devtools/agy-version.sh rewrites both, in every file, at once.
#
# ENV as well as ARG, exactly as with CLAUDE_CODE_VERSION above: it is what
# lets doctor.sh tell the image's own pinned copy from something installed over
# the top of it, which `agy --version` cannot -- that prints 1.3.3 and never
# the build id.
#
# AGY_CLI_DISABLE_AUTO_UPDATE is the binary's own opt-out of the background
# self-update it otherwise runs during normal use -- the counterpart of
# `autoUpdates: false` in .devcontainer/seed-claude-config.sh. The install is
# root-owned and the container runs as uid 1000, so an update attempt fails
# regardless; what this stops is it being attempted behind the image's back.
ARG AGY_RELEASE=1.4.11-5180209989812224
ARG AGY_SHA512=2935601efa745ed6e314d32b415c71f44d9d455f0e6a2583372584be5a9074c28154cf81d5eec65b4416579453a3b3b05d3abe4d4f176754d5ef93a84af6cf28
ENV AGY_RELEASE=${AGY_RELEASE} \
    AGY_CLI_DISABLE_AUTO_UPDATE=1
RUN --mount=type=bind,source=docker/install-agy.sh,target=/tmp/install-agy.sh \
    AGY_SHA512="${AGY_SHA512}" bash /tmp/install-agy.sh

USER ubuntu
RUN nvcc --version | grep release && hipconfig --version
