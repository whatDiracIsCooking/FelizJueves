        double mu2_1_1 = (q * (H0_1_0__0_1_1__0_0_0__0_0_0 + (BC_z * H0_1_0__0_1_0__0_0_0__0_0_0)));
        double mu0_1_2 = (q * (H0_1_0__1_0_1__0_0_0__0_0_0 + (BC_x * H0_1_0__0_0_1__0_0_0__0_0_0)));
        double mu1_1_2 = (q * (H0_1_0__0_1_1__0_0_0__0_0_0 + (BC_y * H0_1_0__0_0_1__0_0_0__0_0_0)));
        double mu2_1_2 = (q * (H0_1_0__0_0_2__0_0_0__0_0_0 + (BC_z * H0_1_0__0_0_1__0_0_0__0_0_0)));
        double mu0_2_0 = (q * (H0_0_1__2_0_0__0_0_0__0_0_0 + (BC_x * H0_0_1__1_0_0__0_0_0__0_0_0)));
        double mu1_2_0 = (q * (H0_0_1__1_1_0__0_0_0__0_0_0 + (BC_y * H0_0_1__1_0_0__0_0_0__0_0_0)));
        double mu2_2_0 = (q * (H0_0_1__1_0_1__0_0_0__0_0_0 + (BC_z * H0_0_1__1_0_0__0_0_0__0_0_0)));
        double mu0_2_1 = (q * (H0_0_1__1_1_0__0_0_0__0_0_0 + (BC_x * H0_0_1__0_1_0__0_0_0__0_0_0)));
        double mu1_2_1 = (q * (H0_0_1__0_2_0__0_0_0__0_0_0 + (BC_y * H0_0_1__0_1_0__0_0_0__0_0_0)));
        double mu2_2_1 = (q * (H0_0_1__0_1_1__0_0_0__0_0_0 + (BC_z * H0_0_1__0_1_0__0_0_0__0_0_0)));
        double mu0_2_2 = (q * (H0_0_1__1_0_1__0_0_0__0_0_0 + (BC_x * H0_0_1__0_0_1__0_0_0__0_0_0)));
        double mu1_2_2 = (q * (H0_0_1__0_1_1__0_0_0__0_0_0 + (BC_y * H0_0_1__0_0_1__0_0_0__0_0_0)));
        double mu2_2_2 = (q * (H0_0_1__0_0_2__0_0_0__0_0_0 + (BC_z * H0_0_1__0_0_1__0_0_0__0_0_0)));
        // scatter into the matrix and its mirror
        if ((oa < ob) + (ob < oa)) {
            // a plain store, no atomics: every element belongs to one shell pair and is
            // written once (one thread per contracted shell pair), so the result is bit-
            // reproducible; elements of pairs not launched are untouched
            MU[((0 * n_ao + (oa + 0)) * n_ao + (ob + 0))] = mu0_0_0;
            MU[((0 * n_ao + (ob + 0)) * n_ao + (oa + 0))] = mu0_0_0;
            MU[((0 * n_ao + (oa + 0)) * n_ao + (ob + 1))] = mu0_0_1;
            MU[((0 * n_ao + (ob + 1)) * n_ao + (oa + 0))] = mu0_0_1;
            MU[((0 * n_ao + (oa + 0)) * n_ao + (ob + 2))] = mu0_0_2;
            MU[((0 * n_ao + (ob + 2)) * n_ao + (oa + 0))] = mu0_0_2;
            MU[((0 * n_ao + (oa + 1)) * n_ao + (ob + 0))] = mu0_1_0;
            MU[((0 * n_ao + (ob + 0)) * n_ao + (oa + 1))] = mu0_1_0;
            MU[((0 * n_ao + (oa + 1)) * n_ao + (ob + 1))] = mu0_1_1;
            MU[((0 * n_ao + (ob + 1)) * n_ao + (oa + 1))] = mu0_1_1;
            MU[((0 * n_ao + (oa + 1)) * n_ao + (ob + 2))] = mu0_1_2;
            MU[((0 * n_ao + (ob + 2)) * n_ao + (oa + 1))] = mu0_1_2;
            MU[((0 * n_ao + (oa + 2)) * n_ao + (ob + 0))] = mu0_2_0;
            MU[((0 * n_ao + (ob + 0)) * n_ao + (oa + 2))] = mu0_2_0;
            MU[((0 * n_ao + (oa + 2)) * n_ao + (ob + 1))] = mu0_2_1;
            MU[((0 * n_ao + (ob + 1)) * n_ao + (oa + 2))] = mu0_2_1;
            MU[((0 * n_ao + (oa + 2)) * n_ao + (ob + 2))] = mu0_2_2;
            MU[((0 * n_ao + (ob + 2)) * n_ao + (oa + 2))] = mu0_2_2;
            MU[((1 * n_ao + (oa + 0)) * n_ao + (ob + 0))] = mu1_0_0;
            MU[((1 * n_ao + (ob + 0)) * n_ao + (oa + 0))] = mu1_0_0;
            MU[((1 * n_ao + (oa + 0)) * n_ao + (ob + 1))] = mu1_0_1;
            MU[((1 * n_ao + (ob + 1)) * n_ao + (oa + 0))] = mu1_0_1;
            MU[((1 * n_ao + (oa + 0)) * n_ao + (ob + 2))] = mu1_0_2;
            MU[((1 * n_ao + (ob + 2)) * n_ao + (oa + 0))] = mu1_0_2;
            MU[((1 * n_ao + (oa + 1)) * n_ao + (ob + 0))] = mu1_1_0;
            MU[((1 * n_ao + (ob + 0)) * n_ao + (oa + 1))] = mu1_1_0;
            MU[((1 * n_ao + (oa + 1)) * n_ao + (ob + 1))] = mu1_1_1;
            MU[((1 * n_ao + (ob + 1)) * n_ao + (oa + 1))] = mu1_1_1;
            MU[((1 * n_ao + (oa + 1)) * n_ao + (ob + 2))] = mu1_1_2;
            MU[((1 * n_ao + (ob + 2)) * n_ao + (oa + 1))] = mu1_1_2;
            MU[((1 * n_ao + (oa + 2)) * n_ao + (ob + 0))] = mu1_2_0;
            MU[((1 * n_ao + (ob + 0)) * n_ao + (oa + 2))] = mu1_2_0;
            MU[((1 * n_ao + (oa + 2)) * n_ao + (ob + 1))] = mu1_2_1;
            MU[((1 * n_ao + (ob + 1)) * n_ao + (oa + 2))] = mu1_2_1;
            MU[((1 * n_ao + (oa + 2)) * n_ao + (ob + 2))] = mu1_2_2;
            MU[((1 * n_ao + (ob + 2)) * n_ao + (oa + 2))] = mu1_2_2;
            MU[((2 * n_ao + (oa + 0)) * n_ao + (ob + 0))] = mu2_0_0;
            MU[((2 * n_ao + (ob + 0)) * n_ao + (oa + 0))] = mu2_0_0;
            MU[((2 * n_ao + (oa + 0)) * n_ao + (ob + 1))] = mu2_0_1;
            MU[((2 * n_ao + (ob + 1)) * n_ao + (oa + 0))] = mu2_0_1;
            MU[((2 * n_ao + (oa + 0)) * n_ao + (ob + 2))] = mu2_0_2;
            MU[((2 * n_ao + (ob + 2)) * n_ao + (oa + 0))] = mu2_0_2;
            MU[((2 * n_ao + (oa + 1)) * n_ao + (ob + 0))] = mu2_1_0;
            MU[((2 * n_ao + (ob + 0)) * n_ao + (oa + 1))] = mu2_1_0;
            MU[((2 * n_ao + (oa + 1)) * n_ao + (ob + 1))] = mu2_1_1;
            MU[((2 * n_ao + (ob + 1)) * n_ao + (oa + 1))] = mu2_1_1;
            MU[((2 * n_ao + (oa + 1)) * n_ao + (ob + 2))] = mu2_1_2;
            MU[((2 * n_ao + (ob + 2)) * n_ao + (oa + 1))] = mu2_1_2;
            MU[((2 * n_ao + (oa + 2)) * n_ao + (ob + 0))] = mu2_2_0;
            MU[((2 * n_ao + (ob + 0)) * n_ao + (oa + 2))] = mu2_2_0;
            MU[((2 * n_ao + (oa + 2)) * n_ao + (ob + 1))] = mu2_2_1;
            MU[((2 * n_ao + (ob + 1)) * n_ao + (oa + 2))] = mu2_2_1;
            MU[((2 * n_ao + (oa + 2)) * n_ao + (ob + 2))] = mu2_2_2;
            MU[((2 * n_ao + (ob + 2)) * n_ao + (oa + 2))] = mu2_2_2;
        } else {
            // diagonal shell pair (off_a == off_b): the lower triangle i >= j only, each
            // mirrored -- kernel_jab's placement
            MU[((0 * n_ao + (oa + 0)) * n_ao + (oa + 0))] = mu0_0_0;
            MU[((0 * n_ao + (oa + 1)) * n_ao + (oa + 0))] = mu0_1_0;
            MU[((0 * n_ao + (oa + 0)) * n_ao + (oa + 1))] = mu0_1_0;
            MU[((0 * n_ao + (oa + 1)) * n_ao + (oa + 1))] = mu0_1_1;
            MU[((0 * n_ao + (oa + 2)) * n_ao + (oa + 0))] = mu0_2_0;
            MU[((0 * n_ao + (oa + 0)) * n_ao + (oa + 2))] = mu0_2_0;
