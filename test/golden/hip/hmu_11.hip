            MU[((1 * n_ao + (oa + 1)) * n_ao + (oa + 1))] = mu1_1_1;
            MU[((1 * n_ao + (oa + 2)) * n_ao + (oa + 0))] = mu1_2_0;
            MU[((1 * n_ao + (oa + 0)) * n_ao + (oa + 2))] = mu1_2_0;
            MU[((1 * n_ao + (oa + 2)) * n_ao + (oa + 1))] = mu1_2_1;
            MU[((1 * n_ao + (oa + 1)) * n_ao + (oa + 2))] = mu1_2_1;
            MU[((1 * n_ao + (oa + 2)) * n_ao + (oa + 2))] = mu1_2_2;
            MU[((2 * n_ao + (oa + 0)) * n_ao + (oa + 0))] = mu2_0_0;
