            MU[((2 * n_ao + (oa + 1)) * n_ao + (oa + 1))] = mu2_1_1;
            MU[((2 * n_ao + (oa + 2)) * n_ao + (oa + 0))] = mu2_2_0;
            MU[((2 * n_ao + (oa + 0)) * n_ao + (oa + 2))] = mu2_2_0;
            MU[((2 * n_ao + (oa + 2)) * n_ao + (oa + 1))] = mu2_2_1;
