                    f_ac_0_1 = (f_ac_0_1 + (w_bd_2_3 * H0_0_0__0_0_1__0_1_0__0_2_0));
                    f_ad_0_3 = (f_ad_0_3 + (w_bc_2_1 * H0_0_0__0_0_1__0_1_0__0_2_0));
                    f_bc_2_1 = (f_bc_2_1 + (w_ad_0_3 * H0_0_0__0_0_1__0_1_0__0_2_0));
                    f_bd_2_3 = (f_bd_2_3 + (w_ac_0_1 * H0_0_0__0_0_1__0_1_0__0_2_0));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_1_4 * H0_0_0__0_0_1__0_1_0__0_1_1));
                    f_cd_1_4 = (f_cd_1_4 + (w_ab_0_2 * H0_0_0__0_0_1__0_1_0__0_1_1));
                    f_ac_0_1 = (f_ac_0_1 + (w_bd_2_4 * H0_0_0__0_0_1__0_1_0__0_1_1));
                    f_ad_0_4 = (f_ad_0_4 + (w_bc_2_1 * H0_0_0__0_0_1__0_1_0__0_1_1));
                    f_bc_2_1 = (f_bc_2_1 + (w_ad_0_4 * H0_0_0__0_0_1__0_1_0__0_1_1));
                    f_bd_2_4 = (f_bd_2_4 + (w_ac_0_1 * H0_0_0__0_0_1__0_1_0__0_1_1));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_1_5 * H0_0_0__0_0_1__0_1_0__0_0_2));
                    f_cd_1_5 = (f_cd_1_5 + (w_ab_0_2 * H0_0_0__0_0_1__0_1_0__0_0_2));
                    f_ac_0_1 = (f_ac_0_1 + (w_bd_2_5 * H0_0_0__0_0_1__0_1_0__0_0_2));
                    f_ad_0_5 = (f_ad_0_5 + (w_bc_2_1 * H0_0_0__0_0_1__0_1_0__0_0_2));
                    f_bc_2_1 = (f_bc_2_1 + (w_ad_0_5 * H0_0_0__0_0_1__0_1_0__0_0_2));
                    f_bd_2_5 = (f_bd_2_5 + (w_ac_0_1 * H0_0_0__0_0_1__0_1_0__0_0_2));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_2_0 * H0_0_0__0_0_1__0_0_1__2_0_0));
                    f_cd_2_0 = (f_cd_2_0 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_1__2_0_0));
                    f_ac_0_2 = (f_ac_0_2 + (w_bd_2_0 * H0_0_0__0_0_1__0_0_1__2_0_0));
                    f_ad_0_0 = (f_ad_0_0 + (w_bc_2_2 * H0_0_0__0_0_1__0_0_1__2_0_0));
                    f_bc_2_2 = (f_bc_2_2 + (w_ad_0_0 * H0_0_0__0_0_1__0_0_1__2_0_0));
                    f_bd_2_0 = (f_bd_2_0 + (w_ac_0_2 * H0_0_0__0_0_1__0_0_1__2_0_0));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_2_1 * H0_0_0__0_0_1__0_0_1__1_1_0));
                    f_cd_2_1 = (f_cd_2_1 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_1__1_1_0));
                    f_ac_0_2 = (f_ac_0_2 + (w_bd_2_1 * H0_0_0__0_0_1__0_0_1__1_1_0));
                    f_ad_0_1 = (f_ad_0_1 + (w_bc_2_2 * H0_0_0__0_0_1__0_0_1__1_1_0));
                    f_bc_2_2 = (f_bc_2_2 + (w_ad_0_1 * H0_0_0__0_0_1__0_0_1__1_1_0));
                    f_bd_2_1 = (f_bd_2_1 + (w_ac_0_2 * H0_0_0__0_0_1__0_0_1__1_1_0));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_2_2 * H0_0_0__0_0_1__0_0_1__1_0_1));
                    f_cd_2_2 = (f_cd_2_2 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_1__1_0_1));
                    f_ac_0_2 = (f_ac_0_2 + (w_bd_2_2 * H0_0_0__0_0_1__0_0_1__1_0_1));
                    f_ad_0_2 = (f_ad_0_2 + (w_bc_2_2 * H0_0_0__0_0_1__0_0_1__1_0_1));
                    f_bc_2_2 = (f_bc_2_2 + (w_ad_0_2 * H0_0_0__0_0_1__0_0_1__1_0_1));
                    f_bd_2_2 = (f_bd_2_2 + (w_ac_0_2 * H0_0_0__0_0_1__0_0_1__1_0_1));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_2_3 * H0_0_0__0_0_1__0_0_1__0_2_0));
                    f_cd_2_3 = (f_cd_2_3 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_1__0_2_0));
                    f_ac_0_2 = (f_ac_0_2 + (w_bd_2_3 * H0_0_0__0_0_1__0_0_1__0_2_0));
                    f_ad_0_3 = (f_ad_0_3 + (w_bc_2_2 * H0_0_0__0_0_1__0_0_1__0_2_0));
                    f_bc_2_2 = (f_bc_2_2 + (w_ad_0_3 * H0_0_0__0_0_1__0_0_1__0_2_0));
                    f_bd_2_3 = (f_bd_2_3 + (w_ac_0_2 * H0_0_0__0_0_1__0_0_1__0_2_0));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_2_4 * H0_0_0__0_0_1__0_0_1__0_1_1));
                    f_cd_2_4 = (f_cd_2_4 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_1__0_1_1));
                    f_ac_0_2 = (f_ac_0_2 + (w_bd_2_4 * H0_0_0__0_0_1__0_0_1__0_1_1));
                    f_ad_0_4 = (f_ad_0_4 + (w_bc_2_2 * H0_0_0__0_0_1__0_0_1__0_1_1));
                    f_bc_2_2 = (f_bc_2_2 + (w_ad_0_4 * H0_0_0__0_0_1__0_0_1__0_1_1));
                    f_bd_2_4 = (f_bd_2_4 + (w_ac_0_2 * H0_0_0__0_0_1__0_0_1__0_1_1));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_2_5 * H0_0_0__0_0_1__0_0_1__0_0_2));
                    f_cd_2_5 = (f_cd_2_5 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_1__0_0_2));
                    f_ac_0_2 = (f_ac_0_2 + (w_bd_2_5 * H0_0_0__0_0_1__0_0_1__0_0_2));
                    f_ad_0_5 = (f_ad_0_5 + (w_bc_2_2 * H0_0_0__0_0_1__0_0_1__0_0_2));
                    f_bc_2_2 = (f_bc_2_2 + (w_ad_0_5 * H0_0_0__0_0_1__0_0_1__0_0_2));
                    f_bd_2_5 = (f_bd_2_5 + (w_ac_0_2 * H0_0_0__0_0_1__0_0_1__0_0_2));
                    // flush the five ket-dependent buffers: AtomicAdd, the only atomics besides
                    // f_ab's one flush
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 0))], f_cd_0_0);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 1))], f_cd_0_1);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 2))], f_cd_0_2);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 3))], f_cd_0_3);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 4))], f_cd_0_4);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 5))], f_cd_0_5);
                    atomicAdd(&F[((oc + 1) * n_ao + (od + 0))], f_cd_1_0);
                    atomicAdd(&F[((oc + 1) * n_ao + (od + 1))], f_cd_1_1);
                    atomicAdd(&F[((oc + 1) * n_ao + (od + 2))], f_cd_1_2);
                    atomicAdd(&F[((oc + 1) * n_ao + (od + 3))], f_cd_1_3);
                    atomicAdd(&F[((oc + 1) * n_ao + (od + 4))], f_cd_1_4);
                    atomicAdd(&F[((oc + 1) * n_ao + (od + 5))], f_cd_1_5);
                    atomicAdd(&F[((oc + 2) * n_ao + (od + 0))], f_cd_2_0);
                    atomicAdd(&F[((oc + 2) * n_ao + (od + 1))], f_cd_2_1);
                    atomicAdd(&F[((oc + 2) * n_ao + (od + 2))], f_cd_2_2);
                    atomicAdd(&F[((oc + 2) * n_ao + (od + 3))], f_cd_2_3);
                    atomicAdd(&F[((oc + 2) * n_ao + (od + 4))], f_cd_2_4);
                    atomicAdd(&F[((oc + 2) * n_ao + (od + 5))], f_cd_2_5);
                    atomicAdd(&F[((oa + 0) * n_ao + (oc + 0))], f_ac_0_0);
                    atomicAdd(&F[((oa + 0) * n_ao + (oc + 1))], f_ac_0_1);
                    atomicAdd(&F[((oa + 0) * n_ao + (oc + 2))], f_ac_0_2);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 0))], f_ad_0_0);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 1))], f_ad_0_1);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 2))], f_ad_0_2);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 3))], f_ad_0_3);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 4))], f_ad_0_4);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 5))], f_ad_0_5);
                    atomicAdd(&F[((ob + 0) * n_ao + (oc + 0))], f_bc_0_0);
                    atomicAdd(&F[((ob + 0) * n_ao + (oc + 1))], f_bc_0_1);
                    atomicAdd(&F[((ob + 0) * n_ao + (oc + 2))], f_bc_0_2);
                    atomicAdd(&F[((ob + 1) * n_ao + (oc + 0))], f_bc_1_0);
                    atomicAdd(&F[((ob + 1) * n_ao + (oc + 1))], f_bc_1_1);
                    atomicAdd(&F[((ob + 1) * n_ao + (oc + 2))], f_bc_1_2);
                    atomicAdd(&F[((ob + 2) * n_ao + (oc + 0))], f_bc_2_0);
                    atomicAdd(&F[((ob + 2) * n_ao + (oc + 1))], f_bc_2_1);
                    atomicAdd(&F[((ob + 2) * n_ao + (oc + 2))], f_bc_2_2);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 0))], f_bd_0_0);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 1))], f_bd_0_1);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 2))], f_bd_0_2);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 3))], f_bd_0_3);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 4))], f_bd_0_4);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 5))], f_bd_0_5);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 0))], f_bd_1_0);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 1))], f_bd_1_1);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 2))], f_bd_1_2);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 3))], f_bd_1_3);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 4))], f_bd_1_4);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 5))], f_bd_1_5);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 0))], f_bd_2_0);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 1))], f_bd_2_1);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 2))], f_bd_2_2);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 3))], f_bd_2_3);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 4))], f_bd_2_4);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 5))], f_bd_2_5);
                }
            }
        }
        // flush f_ab: once per thread, after its whole ket loop
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 0))], f_ab_0_0);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 1))], f_ab_0_1);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 2))], f_ab_0_2);
    }
}
