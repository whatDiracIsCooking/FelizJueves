template <int N>
__device__ __forceinline__ void fj_rys(double T, double (&x)[N], double (&w)[N]) {
    static_assert(N >= 1 && N <= 5, "fj_rys: N in 1..5");
    if (T >= 80.0) {
        const int o = (N - 1) * N / 2;
        const double h = 2.0 * sqrt(T);
        for (int i = 0; i < N; ++i) {
            x[i] = FJ_RYS_LS[o + i] / T;
            w[i] = FJ_RYS_LW[o + i] / h;
        }
        return;
    }
    double mu[44];
    for (int j = 0; j < 44; ++j) {
        mu[j] = FJ_RYS_U[j] * exp(-T * FJ_RYS_Y[j]);
    }
    double a[N];
    double b[N];
    double norm_prev = 1.0;
    for (int k = 0; k < N; ++k) {
        double nrm = 0.0;
        double xn = 0.0;
        for (int j = 0; j < 44; ++j) {
            const double yj = FJ_RYS_Y[j];
            double p0 = 0.0;
            double p1 = 1.0;
            for (int m = 0; m < k; ++m) {
                const double pn = (yj - a[m]) * p1 - b[m] * p0;
                p0 = p1;
                p1 = pn;
            }
            const double pp = mu[j] * p1 * p1;
            nrm = nrm + pp;
            xn = xn + pp * yj;
        }
        a[k] = xn / nrm;
        b[k] = (k == 0) ? nrm : nrm / norm_prev;
        norm_prev = nrm;
    }
    for (int i = 0; i < N; ++i) {
        double lo = 0.0;
        double hi = 1.0;
        for (int it = 0; it < 64; ++it) {
            const double mid = 0.5 * (lo + hi);
            int c = 0;
            double d = a[0] - mid;
            if (d < 0.0) {
                ++c;
            }
            for (int k = 1; k < N; ++k) {
                if (d == 0.0) {
                    d = 1e-300;
                }
                d = (a[k] - mid) - b[k] / d;
                if (d < 0.0) {
                    ++c;
                }
            }
            if (c > i) {
                hi = mid;
            } else {
                lo = mid;
            }
        }
        x[i] = 0.5 * (lo + hi);
    }
    for (int i = 0; i < N; ++i) {
        double p0 = 0.0;
        double p1 = 1.0;
        double h = 1.0;
        double s = 0.0;
        for (int k = 0; k < N; ++k) {
            h = h * b[k];
            s = s + p1 * p1 / h;
            const double pn = (x[i] - a[k]) * p1 - b[k] * p0;
            p0 = p1;
            p1 = pn;
        }
        w[i] = 1.0 / s;
    }
}

