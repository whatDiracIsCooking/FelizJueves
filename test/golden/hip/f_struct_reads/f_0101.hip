                    double H0_0_0__0_0_1__1_0_0__0_0_0 = (H0_0_1__0_0_0__1_0_0__0_0_0 + (AB_z * H0_0_0__0_0_0__1_0_0__0_0_0));
                    double H0_0_0__0_0_1__0_1_0__0_0_0 = (H0_0_1__0_0_0__0_1_0__0_0_0 + (AB_z * H0_0_0__0_0_0__0_1_0__0_0_0));
                    double H0_0_0__0_0_1__0_0_1__0_0_0 = (H0_0_1__0_0_0__0_0_1__0_0_0 + (AB_z * H0_0_0__0_0_0__0_0_1__0_0_0));
                    double H0_0_0__0_0_1__0_0_0__0_0_0 = (H0_0_1__0_0_0__0_0_0__0_0_0 + (AB_z * H0_0_0__0_0_0__0_0_0__0_0_0));
                    double H0_0_0__1_0_0__0_0_0__1_0_0 = (H0_0_0__1_0_0__1_0_0__0_0_0 + (CD_x * H0_0_0__1_0_0__0_0_0__0_0_0));
                    double H0_0_0__1_0_0__0_0_0__0_1_0 = (H0_0_0__1_0_0__0_1_0__0_0_0 + (CD_y * H0_0_0__1_0_0__0_0_0__0_0_0));
                    double H0_0_0__1_0_0__0_0_0__0_0_1 = (H0_0_0__1_0_0__0_0_1__0_0_0 + (CD_z * H0_0_0__1_0_0__0_0_0__0_0_0));
                    double H0_0_0__0_1_0__0_0_0__1_0_0 = (H0_0_0__0_1_0__1_0_0__0_0_0 + (CD_x * H0_0_0__0_1_0__0_0_0__0_0_0));
                    double H0_0_0__0_1_0__0_0_0__0_1_0 = (H0_0_0__0_1_0__0_1_0__0_0_0 + (CD_y * H0_0_0__0_1_0__0_0_0__0_0_0));
                    double H0_0_0__0_1_0__0_0_0__0_0_1 = (H0_0_0__0_1_0__0_0_1__0_0_0 + (CD_z * H0_0_0__0_1_0__0_0_0__0_0_0));
                    double H0_0_0__0_0_1__0_0_0__1_0_0 = (H0_0_0__0_0_1__1_0_0__0_0_0 + (CD_x * H0_0_0__0_0_1__0_0_0__0_0_0));
                    double H0_0_0__0_0_1__0_0_0__0_1_0 = (H0_0_0__0_0_1__0_1_0__0_0_0 + (CD_y * H0_0_0__0_0_1__0_0_0__0_0_0));
                    double H0_0_0__0_0_1__0_0_0__0_0_1 = (H0_0_0__0_0_1__0_0_1__0_0_0 + (CD_z * H0_0_0__0_0_1__0_0_0__0_0_0));
                    // the degeneracy factor 1/|Stab| (module docstring): 1/2 for a = b, for c = d,
                    // and for P = Q
                    double deg = 1.0;
                    if (k < (kmin + diag)) {
                        // P = Q: the diagonal launch at k == bra
                        deg = (deg * 0.5);
                    }
                    double s_j = (2.0 * deg);
                    double s_k = ((-0.5) * deg);
                    int oc = reinterpret_cast<const fj_index_pair*>(ket_ao)[k].a;
                    int od = reinterpret_cast<const fj_index_pair*>(ket_ao)[k].b;
                    // the weighted densities: w = (fraction x in-order members) deg D, the weight
                    // folded in once per quartet
                    double w_ab_0_0 = (s_j * d_ab_0_0);
                    double w_ab_0_1 = (s_j * d_ab_0_1);
                    double w_ab_0_2 = (s_j * d_ab_0_2);
                    double w_cd_0_0 = (s_j * D[((oc + 0) * n_ao + (od + 0))]);
                    double w_cd_0_1 = (s_j * D[((oc + 0) * n_ao + (od + 1))]);
                    double w_cd_0_2 = (s_j * D[((oc + 0) * n_ao + (od + 2))]);
                    double w_ac_0_0 = (s_k * D[((oa + 0) * n_ao + (oc + 0))]);
                    double w_ad_0_0 = (s_k * D[((oa + 0) * n_ao + (od + 0))]);
                    double w_ad_0_1 = (s_k * D[((oa + 0) * n_ao + (od + 1))]);
                    double w_ad_0_2 = (s_k * D[((oa + 0) * n_ao + (od + 2))]);
                    double w_bc_0_0 = (s_k * D[((ob + 0) * n_ao + (oc + 0))]);
                    double w_bc_1_0 = (s_k * D[((ob + 1) * n_ao + (oc + 0))]);
                    double w_bc_2_0 = (s_k * D[((ob + 2) * n_ao + (oc + 0))]);
                    double w_bd_0_0 = (s_k * D[((ob + 0) * n_ao + (od + 0))]);
                    double w_bd_0_1 = (s_k * D[((ob + 0) * n_ao + (od + 1))]);
                    double w_bd_0_2 = (s_k * D[((ob + 0) * n_ao + (od + 2))]);
                    double w_bd_1_0 = (s_k * D[((ob + 1) * n_ao + (od + 0))]);
                    double w_bd_1_1 = (s_k * D[((ob + 1) * n_ao + (od + 1))]);
                    double w_bd_1_2 = (s_k * D[((ob + 1) * n_ao + (od + 2))]);
                    double w_bd_2_0 = (s_k * D[((ob + 2) * n_ao + (od + 0))]);
                    double w_bd_2_1 = (s_k * D[((ob + 2) * n_ao + (od + 1))]);
                    double w_bd_2_2 = (s_k * D[((ob + 2) * n_ao + (od + 2))]);
                    // the five ket-dependent buffers, zeroed per quartet
                    double f_cd_0_0 = 0.0;
                    double f_cd_0_1 = 0.0;
                    double f_cd_0_2 = 0.0;
                    double f_ac_0_0 = 0.0;
                    double f_ad_0_0 = 0.0;
                    double f_ad_0_1 = 0.0;
                    double f_ad_0_2 = 0.0;
                    double f_bc_0_0 = 0.0;
                    double f_bc_1_0 = 0.0;
                    double f_bc_2_0 = 0.0;
                    double f_bd_0_0 = 0.0;
                    double f_bd_0_1 = 0.0;
                    double f_bd_0_2 = 0.0;
                    double f_bd_1_0 = 0.0;
                    double f_bd_1_1 = 0.0;
                    double f_bd_1_2 = 0.0;
                    double f_bd_2_0 = 0.0;
                    double f_bd_2_1 = 0.0;
                    double f_bd_2_2 = 0.0;
                    // the predigest: six multiply-adds per ERI, one per block, each reading the
                    // complementary density
                    f_ab_0_0 = (f_ab_0_0 + (w_cd_0_0 * H0_0_0__1_0_0__0_0_0__1_0_0));
                    f_cd_0_0 = (f_cd_0_0 + (w_ab_0_0 * H0_0_0__1_0_0__0_0_0__1_0_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_0_0 * H0_0_0__1_0_0__0_0_0__1_0_0));
                    f_ad_0_0 = (f_ad_0_0 + (w_bc_0_0 * H0_0_0__1_0_0__0_0_0__1_0_0));
                    f_bc_0_0 = (f_bc_0_0 + (w_ad_0_0 * H0_0_0__1_0_0__0_0_0__1_0_0));
                    f_bd_0_0 = (f_bd_0_0 + (w_ac_0_0 * H0_0_0__1_0_0__0_0_0__1_0_0));
                    f_ab_0_0 = (f_ab_0_0 + (w_cd_0_1 * H0_0_0__1_0_0__0_0_0__0_1_0));
                    f_cd_0_1 = (f_cd_0_1 + (w_ab_0_0 * H0_0_0__1_0_0__0_0_0__0_1_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_0_1 * H0_0_0__1_0_0__0_0_0__0_1_0));
                    f_ad_0_1 = (f_ad_0_1 + (w_bc_0_0 * H0_0_0__1_0_0__0_0_0__0_1_0));
                    f_bc_0_0 = (f_bc_0_0 + (w_ad_0_1 * H0_0_0__1_0_0__0_0_0__0_1_0));
                    f_bd_0_1 = (f_bd_0_1 + (w_ac_0_0 * H0_0_0__1_0_0__0_0_0__0_1_0));
                    f_ab_0_0 = (f_ab_0_0 + (w_cd_0_2 * H0_0_0__1_0_0__0_0_0__0_0_1));
                    f_cd_0_2 = (f_cd_0_2 + (w_ab_0_0 * H0_0_0__1_0_0__0_0_0__0_0_1));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_0_2 * H0_0_0__1_0_0__0_0_0__0_0_1));
                    f_ad_0_2 = (f_ad_0_2 + (w_bc_0_0 * H0_0_0__1_0_0__0_0_0__0_0_1));
                    f_bc_0_0 = (f_bc_0_0 + (w_ad_0_2 * H0_0_0__1_0_0__0_0_0__0_0_1));
                    f_bd_0_2 = (f_bd_0_2 + (w_ac_0_0 * H0_0_0__1_0_0__0_0_0__0_0_1));
                    f_ab_0_1 = (f_ab_0_1 + (w_cd_0_0 * H0_0_0__0_1_0__0_0_0__1_0_0));
                    f_cd_0_0 = (f_cd_0_0 + (w_ab_0_1 * H0_0_0__0_1_0__0_0_0__1_0_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_1_0 * H0_0_0__0_1_0__0_0_0__1_0_0));
                    f_ad_0_0 = (f_ad_0_0 + (w_bc_1_0 * H0_0_0__0_1_0__0_0_0__1_0_0));
                    f_bc_1_0 = (f_bc_1_0 + (w_ad_0_0 * H0_0_0__0_1_0__0_0_0__1_0_0));
                    f_bd_1_0 = (f_bd_1_0 + (w_ac_0_0 * H0_0_0__0_1_0__0_0_0__1_0_0));
                    f_ab_0_1 = (f_ab_0_1 + (w_cd_0_1 * H0_0_0__0_1_0__0_0_0__0_1_0));
                    f_cd_0_1 = (f_cd_0_1 + (w_ab_0_1 * H0_0_0__0_1_0__0_0_0__0_1_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_1_1 * H0_0_0__0_1_0__0_0_0__0_1_0));
                    f_ad_0_1 = (f_ad_0_1 + (w_bc_1_0 * H0_0_0__0_1_0__0_0_0__0_1_0));
                    f_bc_1_0 = (f_bc_1_0 + (w_ad_0_1 * H0_0_0__0_1_0__0_0_0__0_1_0));
                    f_bd_1_1 = (f_bd_1_1 + (w_ac_0_0 * H0_0_0__0_1_0__0_0_0__0_1_0));
                    f_ab_0_1 = (f_ab_0_1 + (w_cd_0_2 * H0_0_0__0_1_0__0_0_0__0_0_1));
                    f_cd_0_2 = (f_cd_0_2 + (w_ab_0_1 * H0_0_0__0_1_0__0_0_0__0_0_1));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_1_2 * H0_0_0__0_1_0__0_0_0__0_0_1));
                    f_ad_0_2 = (f_ad_0_2 + (w_bc_1_0 * H0_0_0__0_1_0__0_0_0__0_0_1));
                    f_bc_1_0 = (f_bc_1_0 + (w_ad_0_2 * H0_0_0__0_1_0__0_0_0__0_0_1));
                    f_bd_1_2 = (f_bd_1_2 + (w_ac_0_0 * H0_0_0__0_1_0__0_0_0__0_0_1));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_0_0 * H0_0_0__0_0_1__0_0_0__1_0_0));
                    f_cd_0_0 = (f_cd_0_0 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_0__1_0_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_2_0 * H0_0_0__0_0_1__0_0_0__1_0_0));
                    f_ad_0_0 = (f_ad_0_0 + (w_bc_2_0 * H0_0_0__0_0_1__0_0_0__1_0_0));
                    f_bc_2_0 = (f_bc_2_0 + (w_ad_0_0 * H0_0_0__0_0_1__0_0_0__1_0_0));
                    f_bd_2_0 = (f_bd_2_0 + (w_ac_0_0 * H0_0_0__0_0_1__0_0_0__1_0_0));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_0_1 * H0_0_0__0_0_1__0_0_0__0_1_0));
                    f_cd_0_1 = (f_cd_0_1 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_0__0_1_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_2_1 * H0_0_0__0_0_1__0_0_0__0_1_0));
                    f_ad_0_1 = (f_ad_0_1 + (w_bc_2_0 * H0_0_0__0_0_1__0_0_0__0_1_0));
                    f_bc_2_0 = (f_bc_2_0 + (w_ad_0_1 * H0_0_0__0_0_1__0_0_0__0_1_0));
                    f_bd_2_1 = (f_bd_2_1 + (w_ac_0_0 * H0_0_0__0_0_1__0_0_0__0_1_0));
                    f_ab_0_2 = (f_ab_0_2 + (w_cd_0_2 * H0_0_0__0_0_1__0_0_0__0_0_1));
                    f_cd_0_2 = (f_cd_0_2 + (w_ab_0_2 * H0_0_0__0_0_1__0_0_0__0_0_1));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_2_2 * H0_0_0__0_0_1__0_0_0__0_0_1));
                    f_ad_0_2 = (f_ad_0_2 + (w_bc_2_0 * H0_0_0__0_0_1__0_0_0__0_0_1));
                    f_bc_2_0 = (f_bc_2_0 + (w_ad_0_2 * H0_0_0__0_0_1__0_0_0__0_0_1));
                    f_bd_2_2 = (f_bd_2_2 + (w_ac_0_0 * H0_0_0__0_0_1__0_0_0__0_0_1));
                    // flush the five ket-dependent buffers: AtomicAdd, the only atomics besides
                    // f_ab's one flush
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 0))], f_cd_0_0);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 1))], f_cd_0_1);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 2))], f_cd_0_2);
                    atomicAdd(&F[((oa + 0) * n_ao + (oc + 0))], f_ac_0_0);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 0))], f_ad_0_0);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 1))], f_ad_0_1);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 2))], f_ad_0_2);
                    atomicAdd(&F[((ob + 0) * n_ao + (oc + 0))], f_bc_0_0);
                    atomicAdd(&F[((ob + 1) * n_ao + (oc + 0))], f_bc_1_0);
                    atomicAdd(&F[((ob + 2) * n_ao + (oc + 0))], f_bc_2_0);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 0))], f_bd_0_0);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 1))], f_bd_0_1);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 2))], f_bd_0_2);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 0))], f_bd_1_0);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 1))], f_bd_1_1);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 2))], f_bd_1_2);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 0))], f_bd_2_0);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 1))], f_bd_2_1);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 2))], f_bd_2_2);
                }
            }
        }
        // flush f_ab: once per thread, after its whole ket loop
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 0))], f_ab_0_0);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 1))], f_ab_0_1);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 2))], f_ab_0_2);
    }
}
