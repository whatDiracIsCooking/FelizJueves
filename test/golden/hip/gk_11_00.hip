                fj_v += __shfl_xor_sync(0xffffffffull, fj_v, fj_o, 32);
            }
            rC2 = fj_v;
        }
        // AtomicAdd by lane 0: every bra record on an atom adds into that atom's row
        // of G
        if ((int)threadIdx.y < 1) {
            atomicAdd(&G[(aa * 3 + 0)], (sb * rA0));
            atomicAdd(&G[(aa * 3 + 1)], (sb * rA1));
            atomicAdd(&G[(aa * 3 + 2)], (sb * rA2));
            atomicAdd(&G[(ac * 3 + 0)], (sb * rC0));
            atomicAdd(&G[(ac * 3 + 1)], (sb * rC1));
            atomicAdd(&G[(ac * 3 + 2)], (sb * rC2));
        }
    }
}
