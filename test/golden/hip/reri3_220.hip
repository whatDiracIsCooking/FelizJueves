    for (int j = 0; j < 44; ++j) {
        mu[j] = FJ_RYS_U[j] * exp(-T * FJ_RYS_Y[j]);
    }
    double a[N];
    double b[N];
    double norm_prev = 1.0;
    for (int k = 0; k < N; ++k) {
        double nrm = 0.0;
        double xn = 0.0;
        for (int j = 0; j < 44; ++j) {
            const double yj = FJ_RYS_Y[j];
            double p0 = 0.0;
            double p1 = 1.0;
            for (int m = 0; m < k; ++m) {
