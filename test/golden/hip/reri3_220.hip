                p0 = p1;
                p1 = pn;
            }
            const double pp = mu[j] * p1 * p1;
            nrm = nrm + pp;
            xn = xn + pp * yj;
        }
        a[k] = xn / nrm;
        b[k] = (k == 0) ? nrm : nrm / norm_prev;
        norm_prev = nrm;
    }
    for (int i = 0; i < N; ++i) {
        double lo = 0.0;
        double hi = 1.0;
        for (int it = 0; it < 64; ++it) {
            const double mid = 0.5 * (lo + hi);
            int c = 0;
            double d = a[0] - mid;
            if (d < 0.0) {
                ++c;
            }
            for (int k = 1; k < N; ++k) {
                if (d == 0.0) {
                    d = 1e-300;
                }
                d = (a[k] - mid) - b[k] / d;
                if (d < 0.0) {
                    ++c;
