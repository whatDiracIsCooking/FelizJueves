        double X5c2_0_1_0_0_1_0 = (t5H0_1_0__0_1_1__0_0_0__0_0_0 + (BC_z * t5H0_1_0__0_1_0__0_0_0__0_0_0));
        double X5c2_0_1_0_0_0_1 = (t5H0_1_0__0_0_2__0_0_0__0_0_0 + (BC_z * t5H0_1_0__0_0_1__0_0_0__0_0_0));
        double X5c2_0_0_1_1_0_0 = (t5H0_0_1__1_0_1__0_0_0__0_0_0 + (BC_z * t5H0_0_1__1_0_0__0_0_0__0_0_0));
        double X5c2_0_0_1_0_1_0 = (t5H0_0_1__0_1_1__0_0_0__0_0_0 + (BC_z * t5H0_0_1__0_1_0__0_0_0__0_0_0));
        double X5c2_0_0_1_0_0_1 = (t5H0_0_1__0_0_2__0_0_0__0_0_0 + (BC_z * t5H0_0_1__0_0_1__0_0_0__0_0_0));
        // d2/dX_k dY_l by dA_k X(a, b) = 2 alpha X(a+1_k, b) - a_k X(a-1_k, b), dB_k
        // likewise, twice; C is fixed, so no operator term
        double h0AA_00 = (w0 * (X3c0_2_0_0_0_0_0 - X1c0_0_0_0_0_0_0));
        double h0AA_01 = (w0 * X3c0_1_1_0_0_0_0);
        double h0AA_02 = (w0 * X3c0_1_0_1_0_0_0);
        double h0AA_11 = (w0 * (X3c0_0_2_0_0_0_0 - X1c0_0_0_0_0_0_0));
        double h0AA_12 = (w0 * X3c0_0_1_1_0_0_0);
        double h0AA_22 = (w0 * (X3c0_0_0_2_0_0_0 - X1c0_0_0_0_0_0_0));
        double h0BB_00 = (w0 * (X4c0_0_0_0_2_0_0 - X2c0_0_0_0_0_0_0));
        double h0BB_01 = (w0 * X4c0_0_0_0_1_1_0);
        double h0BB_02 = (w0 * X4c0_0_0_0_1_0_1);
        double h0BB_11 = (w0 * (X4c0_0_0_0_0_2_0 - X2c0_0_0_0_0_0_0));
        double h0BB_12 = (w0 * X4c0_0_0_0_0_1_1);
        double h0BB_22 = (w0 * (X4c0_0_0_0_0_0_2 - X2c0_0_0_0_0_0_0));
        double h0AB_00 = (w0 * X5c0_1_0_0_1_0_0);
        double h0AB_01 = (w0 * X5c0_1_0_0_0_1_0);
        double h0AB_02 = (w0 * X5c0_1_0_0_0_0_1);
        double h0AB_10 = (w0 * X5c0_0_1_0_1_0_0);
        double h0AB_11 = (w0 * X5c0_0_1_0_0_1_0);
        double h0AB_12 = (w0 * X5c0_0_1_0_0_0_1);
        double h0AB_20 = (w0 * X5c0_0_0_1_1_0_0);
        double h0AB_21 = (w0 * X5c0_0_0_1_0_1_0);
        double h0AB_22 = (w0 * X5c0_0_0_1_0_0_1);
        double h1AA_00 = (w0 * (X3c1_2_0_0_0_0_0 - X1c1_0_0_0_0_0_0));
        double h1AA_01 = (w0 * X3c1_1_1_0_0_0_0);
        double h1AA_02 = (w0 * X3c1_1_0_1_0_0_0);
        double h1AA_11 = (w0 * (X3c1_0_2_0_0_0_0 - X1c1_0_0_0_0_0_0));
        double h1AA_12 = (w0 * X3c1_0_1_1_0_0_0);
        double h1AA_22 = (w0 * (X3c1_0_0_2_0_0_0 - X1c1_0_0_0_0_0_0));
        double h1BB_00 = (w0 * (X4c1_0_0_0_2_0_0 - X2c1_0_0_0_0_0_0));
        double h1BB_01 = (w0 * X4c1_0_0_0_1_1_0);
        double h1BB_02 = (w0 * X4c1_0_0_0_1_0_1);
        double h1BB_11 = (w0 * (X4c1_0_0_0_0_2_0 - X2c1_0_0_0_0_0_0));
        double h1BB_12 = (w0 * X4c1_0_0_0_0_1_1);
        double h1BB_22 = (w0 * (X4c1_0_0_0_0_0_2 - X2c1_0_0_0_0_0_0));
        double h1AB_00 = (w0 * X5c1_1_0_0_1_0_0);
        double h1AB_01 = (w0 * X5c1_1_0_0_0_1_0);
        double h1AB_02 = (w0 * X5c1_1_0_0_0_0_1);
        double h1AB_10 = (w0 * X5c1_0_1_0_1_0_0);
        double h1AB_11 = (w0 * X5c1_0_1_0_0_1_0);
        double h1AB_12 = (w0 * X5c1_0_1_0_0_0_1);
        double h1AB_20 = (w0 * X5c1_0_0_1_1_0_0);
        double h1AB_21 = (w0 * X5c1_0_0_1_0_1_0);
        double h1AB_22 = (w0 * X5c1_0_0_1_0_0_1);
        double h2AA_00 = (w0 * (X3c2_2_0_0_0_0_0 - X1c2_0_0_0_0_0_0));
        double h2AA_01 = (w0 * X3c2_1_1_0_0_0_0);
        double h2AA_02 = (w0 * X3c2_1_0_1_0_0_0);
        double h2AA_11 = (w0 * (X3c2_0_2_0_0_0_0 - X1c2_0_0_0_0_0_0));
        double h2AA_12 = (w0 * X3c2_0_1_1_0_0_0);
        double h2AA_22 = (w0 * (X3c2_0_0_2_0_0_0 - X1c2_0_0_0_0_0_0));
        double h2BB_00 = (w0 * (X4c2_0_0_0_2_0_0 - X2c2_0_0_0_0_0_0));
        double h2BB_01 = (w0 * X4c2_0_0_0_1_1_0);
        double h2BB_02 = (w0 * X4c2_0_0_0_1_0_1);
        double h2BB_11 = (w0 * (X4c2_0_0_0_0_2_0 - X2c2_0_0_0_0_0_0));
        double h2BB_12 = (w0 * X4c2_0_0_0_0_1_1);
        double h2BB_22 = (w0 * (X4c2_0_0_0_0_0_2 - X2c2_0_0_0_0_0_0));
        double h2AB_00 = (w0 * X5c2_1_0_0_1_0_0);
        double h2AB_01 = (w0 * X5c2_1_0_0_0_1_0);
        double h2AB_02 = (w0 * X5c2_1_0_0_0_0_1);
        double h2AB_10 = (w0 * X5c2_0_1_0_1_0_0);
        double h2AB_11 = (w0 * X5c2_0_1_0_0_1_0);
        double h2AB_12 = (w0 * X5c2_0_1_0_0_0_1);
        double h2AB_20 = (w0 * X5c2_0_0_1_1_0_0);
        double h2AB_21 = (w0 * X5c2_0_0_1_0_1_0);
        double h2AB_22 = (w0 * X5c2_0_0_1_0_0_1);
        // AtomicAdd: every shell pair on an atom adds into that atom's blocks of every
        // component of H
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 0)], (q * h0AA_00));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 1)], (q * h0AA_01));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 0)], (q * h0AA_01));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 2)], (q * h0AA_02));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 0)], (q * h0AA_02));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 1)], (q * h0AA_11));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 2)], (q * h0AA_12));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 1)], (q * h0AA_12));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 2)], (q * h0AA_22));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 0)], (q * h0BB_00));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 1)], (q * h0BB_01));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 0)], (q * h0BB_01));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 2)], (q * h0BB_02));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 0)], (q * h0BB_02));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 1)], (q * h0BB_11));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 2)], (q * h0BB_12));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 1)], (q * h0BB_12));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 2)], (q * h0BB_22));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 0)], (q * h0AB_00));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 0)], (q * h0AB_00));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 1)], (q * h0AB_01));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 0)], (q * h0AB_01));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 2)], (q * h0AB_02));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 0)], (q * h0AB_02));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 0)], (q * h0AB_10));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 1)], (q * h0AB_10));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 1)], (q * h0AB_11));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 1)], (q * h0AB_11));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 2)], (q * h0AB_12));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 1)], (q * h0AB_12));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 0)], (q * h0AB_20));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 2)], (q * h0AB_20));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 1)], (q * h0AB_21));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 2)], (q * h0AB_21));
        atomicAdd(&H[((((0 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 2)], (q * h0AB_22));
        atomicAdd(&H[((((0 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 2)], (q * h0AB_22));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 0)], (q * h1AA_00));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 1)], (q * h1AA_01));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 0)], (q * h1AA_01));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 2)], (q * h1AA_02));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 0)], (q * h1AA_02));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 1)], (q * h1AA_11));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 2)], (q * h1AA_12));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 1)], (q * h1AA_12));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 2)], (q * h1AA_22));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 0)], (q * h1BB_00));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 1)], (q * h1BB_01));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 0)], (q * h1BB_01));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 2)], (q * h1BB_02));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 0)], (q * h1BB_02));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 1)], (q * h1BB_11));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 2)], (q * h1BB_12));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 1)], (q * h1BB_12));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 2)], (q * h1BB_22));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 0)], (q * h1AB_00));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 0)], (q * h1AB_00));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 1)], (q * h1AB_01));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 0)], (q * h1AB_01));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 2)], (q * h1AB_02));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 0)], (q * h1AB_02));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 0)], (q * h1AB_10));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 1)], (q * h1AB_10));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 1)], (q * h1AB_11));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 1)], (q * h1AB_11));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 2)], (q * h1AB_12));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 1)], (q * h1AB_12));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 0)], (q * h1AB_20));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 2)], (q * h1AB_20));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 1)], (q * h1AB_21));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 2)], (q * h1AB_21));
        atomicAdd(&H[((((1 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 2)], (q * h1AB_22));
        atomicAdd(&H[((((1 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 2)], (q * h1AB_22));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 0)], (q * h2AA_00));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 1)], (q * h2AA_01));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 0)], (q * h2AA_01));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 0) * n_atom + aa) * 3 + 2)], (q * h2AA_02));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 0)], (q * h2AA_02));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 1)], (q * h2AA_11));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 1) * n_atom + aa) * 3 + 2)], (q * h2AA_12));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 1)], (q * h2AA_12));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 2) * n_atom + aa) * 3 + 2)], (q * h2AA_22));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 0)], (q * h2BB_00));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 1)], (q * h2BB_01));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 0)], (q * h2BB_01));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 0) * n_atom + ab) * 3 + 2)], (q * h2BB_02));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 0)], (q * h2BB_02));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 1)], (q * h2BB_11));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 1) * n_atom + ab) * 3 + 2)], (q * h2BB_12));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 1)], (q * h2BB_12));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 2) * n_atom + ab) * 3 + 2)], (q * h2BB_22));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 0)], (q * h2AB_00));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 0)], (q * h2AB_00));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 1)], (q * h2AB_01));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 0)], (q * h2AB_01));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 0) * n_atom + ab) * 3 + 2)], (q * h2AB_02));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 0)], (q * h2AB_02));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 0)], (q * h2AB_10));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 1)], (q * h2AB_10));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 1)], (q * h2AB_11));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 1)], (q * h2AB_11));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 1) * n_atom + ab) * 3 + 2)], (q * h2AB_12));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 1)], (q * h2AB_12));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 0)], (q * h2AB_20));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 0) * n_atom + aa) * 3 + 2)], (q * h2AB_20));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 1)], (q * h2AB_21));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 1) * n_atom + aa) * 3 + 2)], (q * h2AB_21));
        atomicAdd(&H[((((2 * n_atom + aa) * 3 + 2) * n_atom + ab) * 3 + 2)], (q * h2AB_22));
        atomicAdd(&H[((((2 * n_atom + ab) * 3 + 2) * n_atom + aa) * 3 + 2)], (q * h2AB_22));
    }
}
