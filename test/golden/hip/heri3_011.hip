        term = term * ((2.0 * T) / (double)(2 * M + 2 * k + 1));
        double next = sum + term;
        if (next == sum) {
            break;
        }
        sum = next;
    }
    double f = e * sum;
    F[M] = f;
#pragma unroll
    for (int m = M - 1; m >= 0; --m) {
