// downward, F_m = (2T F_(m+1) + exp(-T)) / (2m+1). Its accuracy on
// reference.boys's domain is a kernel-tier question, not this file's.
template <int M>
__device__ __forceinline__ void fj_boys(double T, double (&F)[M + 1]) {
