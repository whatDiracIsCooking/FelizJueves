                g1 = (g1 + (w * (((((((((((((((((((((((((((((((((((((((Eket[0][0] * (H0_0 * R0_1_0_0)) + (Eket[0][4] * (H0_0 * R2_1_0_0))) + (Eket[0][20] * (H0_0 * R4_1_0_0))) + (Eket[1][5] * (H1_0 * R1_2_0_0))) + (Eket[1][21] * (H1_0 * R3_2_0_0))) + (Eket[2][6] * (H2_0 * R1_1_1_0))) + (Eket[2][22] * (H2_0 * R3_1_1_0))) + (Eket[3][0] * (H3_0 * R0_1_0_0))) + (Eket[3][4] * (H3_0 * R2_1_0_0))) + (Eket[3][7] * (H3_0 * R0_3_0_0))) + (Eket[3][23] * (H3_0 * R2_3_0_0))) + (Eket[4][8] * (H4_0 * R0_2_1_0))) + (Eket[4][24] * (H4_0 * R2_2_1_0))) + (Eket[5][0] * (H5_0 * R0_1_0_0))) + (Eket[5][4] * (H5_0 * R2_1_0_0))) + (Eket[5][9] * (H5_0 * R0_1_2_0))) + (Eket[5][25] * (H5_0 * R2_1_2_0))) + (Eket[6][5] * (H6_0 * R1_2_0_0))) + (Eket[6][26] * (H6_0 * R1_4_0_0))) + (Eket[7][6] * (H7_0 * R1_1_1_0))) + (Eket[7][27] * (H7_0 * R1_3_1_0))) + (Eket[8][5] * (H8_0 * R1_2_0_0))) + (Eket[8][28] * (H8_0 * R1_2_2_0))) + (Eket[9][6] * (H9_0 * R1_1_1_0))) + (Eket[9][29] * (H9_0 * R1_1_3_0))) + (Eket[10][0] * (H10_0 * R0_1_0_0))) + (Eket[10][7] * (H10_0 * R0_3_0_0))) + (Eket[10][30] * (H10_0 * R0_5_0_0))) + (Eket[11][8] * (H11_0 * R0_2_1_0))) + (Eket[11][31] * (H11_0 * R0_4_1_0))) + (Eket[12][0] * (H12_0 * R0_1_0_0))) + (Eket[12][7] * (H12_0 * R0_3_0_0))) + (Eket[12][9] * (H12_0 * R0_1_2_0))) + (Eket[12][32] * (H12_0 * R0_3_2_0))) + (Eket[13][8] * (H13_0 * R0_2_1_0))) + (Eket[13][33] * (H13_0 * R0_2_3_0))) + (Eket[14][0] * (H14_0 * R0_1_0_0))) + (Eket[14][9] * (H14_0 * R0_1_2_0))) + (Eket[14][34] * (H14_0 * R0_1_4_0)))));
