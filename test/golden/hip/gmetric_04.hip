        // d/dB_k = -d/dA_k: [r]^(0) reads A - B
        // AtomicAdd: every record of every pair on an atom adds into that atom's row
        // of G
        atomicAdd(&G[(aa * 3 + 0)], g0);
        atomicAdd(&G[(aa * 3 + 1)], g1);
        atomicAdd(&G[(aa * 3 + 2)], g2);
        atomicAdd(&G[(ab * 3 + 0)], (0.0 - g0));
