            double fA2 = (((((((((w0 * t1H1_0_1__1_0_0__0_0_0__0_0_0) + (w1 * t1H1_0_1__0_1_0__0_0_0__0_0_0)) + (w2 * t1H1_0_1__0_0_1__0_0_0__0_0_0)) + (w3 * t1H0_1_1__1_0_0__0_0_0__0_0_0)) + (w4 * t1H0_1_1__0_1_0__0_0_0__0_0_0)) + (w5 * t1H0_1_1__0_0_1__0_0_0__0_0_0)) + (w6 * (t1H0_0_2__1_0_0__0_0_0__0_0_0 - (1.0 * t0H0_0_0__1_0_0__0_0_0__0_0_0)))) + (w7 * (t1H0_0_2__0_1_0__0_0_0__0_0_0 - (1.0 * t0H0_0_0__0_1_0__0_0_0__0_0_0)))) + (w8 * (t1H0_0_2__0_0_1__0_0_0__0_0_0 - (1.0 * t0H0_0_0__0_0_1__0_0_0__0_0_0))));
            double fB0 = (((((((((w0 * (t2H1_0_0__2_0_0__0_0_0__0_0_0 - (1.0 * t0H1_0_0__0_0_0__0_0_0__0_0_0))) + (w1 * t2H1_0_0__1_1_0__0_0_0__0_0_0)) + (w2 * t2H1_0_0__1_0_1__0_0_0__0_0_0)) + (w3 * (t2H0_1_0__2_0_0__0_0_0__0_0_0 - (1.0 * t0H0_1_0__0_0_0__0_0_0__0_0_0)))) + (w4 * t2H0_1_0__1_1_0__0_0_0__0_0_0)) + (w5 * t2H0_1_0__1_0_1__0_0_0__0_0_0)) + (w6 * (t2H0_0_1__2_0_0__0_0_0__0_0_0 - (1.0 * t0H0_0_1__0_0_0__0_0_0__0_0_0)))) + (w7 * t2H0_0_1__1_1_0__0_0_0__0_0_0)) + (w8 * t2H0_0_1__1_0_1__0_0_0__0_0_0));
            double fB1 = (((((((((w0 * t2H1_0_0__1_1_0__0_0_0__0_0_0) + (w1 * (t2H1_0_0__0_2_0__0_0_0__0_0_0 - (1.0 * t0H1_0_0__0_0_0__0_0_0__0_0_0)))) + (w2 * t2H1_0_0__0_1_1__0_0_0__0_0_0)) + (w3 * t2H0_1_0__1_1_0__0_0_0__0_0_0)) + (w4 * (t2H0_1_0__0_2_0__0_0_0__0_0_0 - (1.0 * t0H0_1_0__0_0_0__0_0_0__0_0_0)))) + (w5 * t2H0_1_0__0_1_1__0_0_0__0_0_0)) + (w6 * t2H0_0_1__1_1_0__0_0_0__0_0_0)) + (w7 * (t2H0_0_1__0_2_0__0_0_0__0_0_0 - (1.0 * t0H0_0_1__0_0_0__0_0_0__0_0_0)))) + (w8 * t2H0_0_1__0_1_1__0_0_0__0_0_0));
            double fB2 = (((((((((w0 * t2H1_0_0__1_0_1__0_0_0__0_0_0) + (w1 * t2H1_0_0__0_1_1__0_0_0__0_0_0)) + (w2 * (t2H1_0_0__0_0_2__0_0_0__0_0_0 - (1.0 * t0H1_0_0__0_0_0__0_0_0__0_0_0)))) + (w3 * t2H0_1_0__1_0_1__0_0_0__0_0_0)) + (w4 * t2H0_1_0__0_1_1__0_0_0__0_0_0)) + (w5 * (t2H0_1_0__0_0_2__0_0_0__0_0_0 - (1.0 * t0H0_1_0__0_0_0__0_0_0__0_0_0)))) + (w6 * t2H0_0_1__1_0_1__0_0_0__0_0_0)) + (w7 * t2H0_0_1__0_1_1__0_0_0__0_0_0)) + (w8 * (t2H0_0_1__0_0_2__0_0_0__0_0_0 - (1.0 * t0H0_0_1__0_0_0__0_0_0__0_0_0))));
            gA0 = (gA0 + fA0);
            gA1 = (gA1 + fA1);
            gA2 = (gA2 + fA2);
            gB0 = (gB0 + fB0);
            gB1 = (gB1 + fB1);
            gB2 = (gB2 + fB2);
            // Hellmann-Feynman: dC = -(dA + dB) of nucleus c's own tables, translational
            // invariance, exact per nucleus
            // AtomicAdd: every pair on an atom adds into that atom's row of G
            atomicAdd(&G[(c * 3 + 0)], (0.0 - (fA0 + fB0)));
            atomicAdd(&G[(c * 3 + 1)], (0.0 - (fA1 + fB1)));
            atomicAdd(&G[(c * 3 + 2)], (0.0 - (fA2 + fB2)));
        }
        // AtomicAdd: every pair on an atom adds into that atom's row of G
        atomicAdd(&G[(aa * 3 + 0)], gA0);
        atomicAdd(&G[(aa * 3 + 1)], gA1);
        atomicAdd(&G[(aa * 3 + 2)], gA2);
        atomicAdd(&G[(ab * 3 + 0)], gB0);
        atomicAdd(&G[(ab * 3 + 1)], gB1);
        atomicAdd(&G[(ab * 3 + 2)], gB2);
    }
