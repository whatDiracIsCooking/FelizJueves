            eri3[(((ob + 0) * n_ao + (oa + 0)) * n_aux + (op + 10))] = acc0_0_10;
            eri3[(((oa + 0) * n_ao + (ob + 0)) * n_aux + (op + 11))] = acc0_0_11;
            eri3[(((ob + 0) * n_ao + (oa + 0)) * n_aux + (op + 11))] = acc0_0_11;
            eri3[(((oa + 0) * n_ao + (ob + 0)) * n_aux + (op + 12))] = acc0_0_12;
            eri3[(((ob + 0) * n_ao + (oa + 0)) * n_aux + (op + 12))] = acc0_0_12;
            eri3[(((oa + 0) * n_ao + (ob + 0)) * n_aux + (op + 13))] = acc0_0_13;
            eri3[(((ob + 0) * n_ao + (oa + 0)) * n_aux + (op + 13))] = acc0_0_13;
            eri3[(((oa + 0) * n_ao + (ob + 0)) * n_aux + (op + 14))] = acc0_0_14;
            eri3[(((ob + 0) * n_ao + (oa + 0)) * n_aux + (op + 14))] = acc0_0_14;
        } else {
            // diagonal AO shell pair (off_a == off_b): a >= b only, each mirrored once --
            // kernel_jab's diagonal rule, so (mn|P) and (nm|P) are one value
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 0))] = acc0_0_0;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 1))] = acc0_0_1;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 2))] = acc0_0_2;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 3))] = acc0_0_3;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 4))] = acc0_0_4;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 5))] = acc0_0_5;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 6))] = acc0_0_6;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 7))] = acc0_0_7;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 8))] = acc0_0_8;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 9))] = acc0_0_9;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 10))] = acc0_0_10;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 11))] = acc0_0_11;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 12))] = acc0_0_12;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 13))] = acc0_0_13;
            eri3[(((oa + 0) * n_ao + (oa + 0)) * n_aux + (op + 14))] = acc0_0_14;
        }
    }
}
