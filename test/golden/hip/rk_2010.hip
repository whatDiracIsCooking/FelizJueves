            ab_sh[i][1] = bra_prim[((bra * k_ab + i) * 8 + 1)];
            ab_sh[i][2] = bra_prim[((bra * k_ab + i) * 8 + 2)];
            ab_sh[i][3] = bra_prim[((bra * k_ab + i) * 8 + 3)];
            ab_sh[i][4] = bra_prim[((bra * k_ab + i) * 8 + 4)];
            ab_sh[i][5] = bra_prim[((bra * k_ab + i) * 8 + 5)];
            ab_sh[i][6] = bra_prim[((bra * k_ab + i) * 8 + 6)];
            ab_sh[i][7] = bra_prim[((bra * k_ab + i) * 8 + 7)];
