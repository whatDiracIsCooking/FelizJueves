                double C2_0_0__0_1_0 = 0.0;
                double C2_0_0__0_0_1 = 0.0;
                double C1_1_0__1_0_0 = 0.0;
                double C1_1_0__0_1_0 = 0.0;
                double C1_1_0__0_0_1 = 0.0;
                double C1_0_1__1_0_0 = 0.0;
