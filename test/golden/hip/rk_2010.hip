                    double Pb1 = ab_sh[kab][1];
                    double Pb2 = ab_sh[kab][2];
                    double PA_x = ab_sh[kab][3];
                    double PA_y = ab_sh[kab][4];
                    double PA_z = ab_sh[kab][5];
                    double p = ab_sh[kab][6];
                    double Ub = ab_sh[kab][7];
                    for (int kcd = 0; kcd < k_cd; kcd += 1) {
                        // the ket primitive pair, from global memory
                        double Qk0 = ket_prim[((k * k_cd + kcd) * 8 + 0)];
                        double Qk1 = ket_prim[((k * k_cd + kcd) * 8 + 1)];
                        double Qk2 = ket_prim[((k * k_cd + kcd) * 8 + 2)];
                        double QC_x = ket_prim[((k * k_cd + kcd) * 8 + 3)];
                        double QC_y = ket_prim[((k * k_cd + kcd) * 8 + 4)];
                        double QC_z = ket_prim[((k * k_cd + kcd) * 8 + 5)];
                        double q = ket_prim[((k * k_cd + kcd) * 8 + 6)];
                        double Uq = ket_prim[((k * k_cd + kcd) * 8 + 7)];
                        // quartet geometry: W - P and W - Q with kernel_f's derived signs, and the 2D
                        // recurrence's scalars
                        double PQ_x = (Pb0 - Qk0);
                        double PQ_y = (Pb1 - Qk1);
                        double PQ_z = (Pb2 - Qk2);
                        double ppq = (p + q);
                        double rho = ((p * q) / ppq);
                        double theta = sqrt(rho);
                        double q_ppq = (q / ppq);
                        double p_ppq = (p / ppq);
                        double WP_x = (0.0 - (q_ppq * PQ_x));
                        double WQ_x = (p_ppq * PQ_x);
                        double WP_y = (0.0 - (q_ppq * PQ_y));
                        double WQ_y = (p_ppq * PQ_y);
                        double WP_z = (0.0 - (q_ppq * PQ_z));
                        double WQ_z = (p_ppq * PQ_z);
                        double inv2p = (0.5 / p);
                        double inv2pq = (0.5 / ppq);
                        double pair = (Ub * Uq);
                        // the Rys rule: N = 2 nodes and weights of (1/2) x^(-1/2) exp(-T x) dx on [0,
                        // 1] at T = rho |PQ|^2 (rys/roots.py); S = U_P U_Q (2/sqrt(pi)) theta, the HGP
                        // fundamental's scale
                        double T = ((theta * theta) * (((PQ_x * PQ_x) + (PQ_y * PQ_y)) + (PQ_z * PQ_z)));
                        double S = (pair * (1.1283791670955126 * theta));
                        double rys_x[2];
                        double rys_w[2];
                        fj_rys<2>(T, rys_x, rys_w);
                        // the Rys root loop: N = 2 nodes, per axis the 2D VRR I(i, k), i <= 2, k <= 1
                        // (rys/recurrence.py)
                        for (int r = 0; r < 2; r += 1) {
                            double rys_xr = rys_x[r];
                            double rys_wr = (S * rys_w[r]);
                            double B00 = (rys_xr * inv2pq);
                            double B10 = (inv2p * (1.0 - (rys_xr * q_ppq)));
                            double c00_x = (PA_x + (rys_xr * WP_x));
                            double d00_x = (QC_x + (rys_xr * WQ_x));
                            double Ix_1_0 = c00_x;
                            double Ix_2_0 = ((c00_x * Ix_1_0) + (1.0 * B10));
                            double Ix_0_1 = d00_x;
                            double Ix_1_1 = ((d00_x * Ix_1_0) + (1.0 * B00));
                            double Ix_2_1 = ((d00_x * Ix_2_0) + ((2.0 * B00) * Ix_1_0));
                            double c00_y = (PA_y + (rys_xr * WP_y));
                            double d00_y = (QC_y + (rys_xr * WQ_y));
                            double Iy_1_0 = c00_y;
                            double Iy_2_0 = ((c00_y * Iy_1_0) + (1.0 * B10));
                            double Iy_0_1 = d00_y;
                            double Iy_1_1 = ((d00_y * Iy_1_0) + (1.0 * B00));
                            double Iy_2_1 = ((d00_y * Iy_2_0) + ((2.0 * B00) * Iy_1_0));
                            double c00_z = (PA_z + (rys_xr * WP_z));
                            double d00_z = (QC_z + (rys_xr * WQ_z));
