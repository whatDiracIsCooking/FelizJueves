                    double x0_0_0 = 0.0;
                    double x0_0_1 = 0.0;
                    double x0_0_2 = 0.0;
                    double x0_1_0 = 0.0;
                    double x0_1_1 = 0.0;
                    double x0_1_2 = 0.0;
                    double x0_2_0 = 0.0;
                    double x0_2_1 = 0.0;
                    double x0_2_2 = 0.0;
                    double x0_3_0 = 0.0;
                    double x0_3_1 = 0.0;
                    double x0_3_2 = 0.0;
                    double x0_4_0 = 0.0;
                    double x0_4_1 = 0.0;
                    double x0_4_2 = 0.0;
