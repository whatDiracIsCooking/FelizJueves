                                        x5_1_0 = (x5_1_0 + (d5_0_1 * H1_1_0__0_0_0__0_1_0__0_0_0));
                                        x5_2_0 = (x5_2_0 + (d5_0_1 * H1_1_0__0_0_0__0_0_1__0_0_0));
                                        x5_0_0 = (x5_0_0 + (d5_0_2 * H1_0_1__0_0_0__1_0_0__0_0_0));
                                        x5_1_0 = (x5_1_0 + (d5_0_2 * H1_0_1__0_0_0__0_1_0__0_0_0));
                                        x5_2_0 = (x5_2_0 + (d5_0_2 * H1_0_1__0_0_0__0_0_1__0_0_0));
                                        x5_0_0 = (x5_0_0 + (d5_0_3 * H0_2_0__0_0_0__1_0_0__0_0_0));
                                        x5_1_0 = (x5_1_0 + (d5_0_3 * H0_2_0__0_0_0__0_1_0__0_0_0));
                                        x5_2_0 = (x5_2_0 + (d5_0_3 * H0_2_0__0_0_0__0_0_1__0_0_0));
                                        x5_0_0 = (x5_0_0 + (d5_0_4 * H0_1_1__0_0_0__1_0_0__0_0_0));
                                        x5_1_0 = (x5_1_0 + (d5_0_4 * H0_1_1__0_0_0__0_1_0__0_0_0));
                                        x5_2_0 = (x5_2_0 + (d5_0_4 * H0_1_1__0_0_0__0_0_1__0_0_0));
                                        x5_0_0 = (x5_0_0 + (d5_0_5 * H0_0_2__0_0_0__1_0_0__0_0_0));
                                        x5_1_0 = (x5_1_0 + (d5_0_5 * H0_0_2__0_0_0__0_1_0__0_0_0));
                                        x5_2_0 = (x5_2_0 + (d5_0_5 * H0_0_2__0_0_0__0_0_1__0_0_0));
                                        atomicAdd(&K[((oc + 0) * n_ao + (ob + 0))], x5_0_0);
                                        atomicAdd(&K[((oc + 1) * n_ao + (ob + 0))], x5_1_0);
                                        atomicAdd(&K[((oc + 2) * n_ao + (ob + 0))], x5_2_0);
                                    } else {
                                        if (perm < 7) {
                                            // orientation GROUP[6] = (2, 3, 1, 0): K lands on built positions (3, 0), D
                                            // read at (2, 1)
                                            double d6_0_0 = D[((oc + 0) * n_ao + (ob + 0))];
                                            double d6_1_0 = D[((oc + 1) * n_ao + (ob + 0))];
                                            double d6_2_0 = D[((oc + 2) * n_ao + (ob + 0))];
                                            double x6_0_0 = 0.0;
                                            double x6_0_1 = 0.0;
                                            double x6_0_2 = 0.0;
                                            double x6_0_3 = 0.0;
                                            double x6_0_4 = 0.0;
                                            double x6_0_5 = 0.0;
                                            x6_0_0 = (x6_0_0 + (d6_0_0 * H2_0_0__0_0_0__1_0_0__0_0_0));
                                            x6_0_0 = (x6_0_0 + (d6_1_0 * H2_0_0__0_0_0__0_1_0__0_0_0));
                                            x6_0_0 = (x6_0_0 + (d6_2_0 * H2_0_0__0_0_0__0_0_1__0_0_0));
                                            x6_0_1 = (x6_0_1 + (d6_0_0 * H1_1_0__0_0_0__1_0_0__0_0_0));
                                            x6_0_1 = (x6_0_1 + (d6_1_0 * H1_1_0__0_0_0__0_1_0__0_0_0));
                                            x6_0_1 = (x6_0_1 + (d6_2_0 * H1_1_0__0_0_0__0_0_1__0_0_0));
                                            x6_0_2 = (x6_0_2 + (d6_0_0 * H1_0_1__0_0_0__1_0_0__0_0_0));
                                            x6_0_2 = (x6_0_2 + (d6_1_0 * H1_0_1__0_0_0__0_1_0__0_0_0));
                                            x6_0_2 = (x6_0_2 + (d6_2_0 * H1_0_1__0_0_0__0_0_1__0_0_0));
                                            x6_0_3 = (x6_0_3 + (d6_0_0 * H0_2_0__0_0_0__1_0_0__0_0_0));
                                            x6_0_3 = (x6_0_3 + (d6_1_0 * H0_2_0__0_0_0__0_1_0__0_0_0));
                                            x6_0_3 = (x6_0_3 + (d6_2_0 * H0_2_0__0_0_0__0_0_1__0_0_0));
                                            x6_0_4 = (x6_0_4 + (d6_0_0 * H0_1_1__0_0_0__1_0_0__0_0_0));
                                            x6_0_4 = (x6_0_4 + (d6_1_0 * H0_1_1__0_0_0__0_1_0__0_0_0));
                                            x6_0_4 = (x6_0_4 + (d6_2_0 * H0_1_1__0_0_0__0_0_1__0_0_0));
                                            x6_0_5 = (x6_0_5 + (d6_0_0 * H0_0_2__0_0_0__1_0_0__0_0_0));
                                            x6_0_5 = (x6_0_5 + (d6_1_0 * H0_0_2__0_0_0__0_1_0__0_0_0));
                                            x6_0_5 = (x6_0_5 + (d6_2_0 * H0_0_2__0_0_0__0_0_1__0_0_0));
                                            atomicAdd(&K[((od + 0) * n_ao + (oa + 0))], x6_0_0);
                                            atomicAdd(&K[((od + 0) * n_ao + (oa + 1))], x6_0_1);
                                            atomicAdd(&K[((od + 0) * n_ao + (oa + 2))], x6_0_2);
                                            atomicAdd(&K[((od + 0) * n_ao + (oa + 3))], x6_0_3);
                                            atomicAdd(&K[((od + 0) * n_ao + (oa + 4))], x6_0_4);
                                            atomicAdd(&K[((od + 0) * n_ao + (oa + 5))], x6_0_5);
                                        } else {
                                            if (perm < 8) {
                                                // orientation GROUP[7] = (3, 2, 1, 0): K lands on built positions (3, 1), D
                                                // read at (2, 0)
                                                double d7_0_0 = D[((oc + 0) * n_ao + (oa + 0))];
                                                double d7_0_1 = D[((oc + 0) * n_ao + (oa + 1))];
                                                double d7_0_2 = D[((oc + 0) * n_ao + (oa + 2))];
                                                double d7_0_3 = D[((oc + 0) * n_ao + (oa + 3))];
                                                double d7_0_4 = D[((oc + 0) * n_ao + (oa + 4))];
                                                double d7_0_5 = D[((oc + 0) * n_ao + (oa + 5))];
                                                double d7_1_0 = D[((oc + 1) * n_ao + (oa + 0))];
                                                double d7_1_1 = D[((oc + 1) * n_ao + (oa + 1))];
                                                double d7_1_2 = D[((oc + 1) * n_ao + (oa + 2))];
                                                double d7_1_3 = D[((oc + 1) * n_ao + (oa + 3))];
                                                double d7_1_4 = D[((oc + 1) * n_ao + (oa + 4))];
                                                double d7_1_5 = D[((oc + 1) * n_ao + (oa + 5))];
                                                double d7_2_0 = D[((oc + 2) * n_ao + (oa + 0))];
                                                double d7_2_1 = D[((oc + 2) * n_ao + (oa + 1))];
                                                double d7_2_2 = D[((oc + 2) * n_ao + (oa + 2))];
                                                double d7_2_3 = D[((oc + 2) * n_ao + (oa + 3))];
                                                double d7_2_4 = D[((oc + 2) * n_ao + (oa + 4))];
                                                double d7_2_5 = D[((oc + 2) * n_ao + (oa + 5))];
                                                double x7_0_0 = 0.0;
                                                x7_0_0 = (x7_0_0 + (d7_0_0 * H2_0_0__0_0_0__1_0_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_1_0 * H2_0_0__0_0_0__0_1_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_2_0 * H2_0_0__0_0_0__0_0_1__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_0_1 * H1_1_0__0_0_0__1_0_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_1_1 * H1_1_0__0_0_0__0_1_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_2_1 * H1_1_0__0_0_0__0_0_1__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_0_2 * H1_0_1__0_0_0__1_0_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_1_2 * H1_0_1__0_0_0__0_1_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_2_2 * H1_0_1__0_0_0__0_0_1__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_0_3 * H0_2_0__0_0_0__1_0_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_1_3 * H0_2_0__0_0_0__0_1_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_2_3 * H0_2_0__0_0_0__0_0_1__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_0_4 * H0_1_1__0_0_0__1_0_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_1_4 * H0_1_1__0_0_0__0_1_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_2_4 * H0_1_1__0_0_0__0_0_1__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_0_5 * H0_0_2__0_0_0__1_0_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_1_5 * H0_0_2__0_0_0__0_1_0__0_0_0));
                                                x7_0_0 = (x7_0_0 + (d7_2_5 * H0_0_2__0_0_0__0_0_1__0_0_0));
                                                atomicAdd(&K[((od + 0) * n_ao + (ob + 0))], x7_0_0);
                                            } else {
                                                // perm is not an orientation of this kernel's orbit
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
