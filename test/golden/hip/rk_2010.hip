                    dmax = Dsh[(sa * n_sh + sd)];
                } else {
                    if (perm < 3) {
                        dmax = Dsh[(sb * n_sh + sc)];
                    } else {
                        if (perm < 4) {
                            dmax = Dsh[(sa * n_sh + sc)];
                        } else {
                            if (perm < 5) {
                                dmax = Dsh[(sd * n_sh + sb)];
                            } else {
                                if (perm < 6) {
                                    dmax = Dsh[(sd * n_sh + sa)];
                                } else {
                                    if (perm < 7) {
                                        dmax = Dsh[(sc * n_sh + sb)];
                                    } else {
                                        if (perm < 8) {
                                            dmax = Dsh[(sc * n_sh + sa)];
                                        } else {
                                            // perm is not an orientation of this kernel's orbit
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
