                            C2_0_0__0_0_1 = (C2_0_0__0_0_1 + (Ix_2_0 * Iz_0_1));
                            C1_1_0__1_0_0 = (C1_1_0__1_0_0 + ((Ix_1_1 * Iy_1_0) * rys_wr));
                            C1_1_0__0_1_0 = (C1_1_0__0_1_0 + ((Ix_1_0 * Iy_1_1) * rys_wr));
                            C1_1_0__0_0_1 = (C1_1_0__0_0_1 + ((Ix_1_0 * Iy_1_0) * Iz_0_1));
                            C1_0_1__1_0_0 = (C1_0_1__1_0_0 + (Ix_1_1 * Iz_1_0));
                            C1_0_1__0_1_0 = (C1_0_1__0_1_0 + ((Ix_1_0 * Iy_0_1) * Iz_1_0));
                            C1_0_1__0_0_1 = (C1_0_1__0_0_1 + (Ix_1_0 * Iz_1_1));
                            C0_2_0__1_0_0 = (C0_2_0__1_0_0 + ((Ix_0_1 * Iy_2_0) * rys_wr));
                            C0_2_0__0_1_0 = (C0_2_0__0_1_0 + (Iy_2_1 * rys_wr));
                            C0_2_0__0_0_1 = (C0_2_0__0_0_1 + (Iy_2_0 * Iz_0_1));
                            C0_1_1__1_0_0 = (C0_1_1__1_0_0 + ((Ix_0_1 * Iy_1_0) * Iz_1_0));
                            C0_1_1__0_1_0 = (C0_1_1__0_1_0 + (Iy_1_1 * Iz_1_0));
                            C0_1_1__0_0_1 = (C0_1_1__0_0_1 + (Iy_1_0 * Iz_1_1));
                            C0_0_2__1_0_0 = (C0_0_2__1_0_0 + (Ix_0_1 * Iz_2_0));
                            C0_0_2__0_1_0 = (C0_0_2__0_1_0 + (Iy_0_1 * Iz_2_0));
