                double C0_2_0__0_1_0 = 0.0;
                double C0_2_0__0_0_1 = 0.0;
                double C0_1_1__1_0_0 = 0.0;
                double C0_1_1__0_1_0 = 0.0;
                double C0_1_1__0_0_1 = 0.0;
                double C0_0_2__1_0_0 = 0.0;
                double C0_0_2__0_1_0 = 0.0;
                double C0_0_2__0_0_1 = 0.0;
