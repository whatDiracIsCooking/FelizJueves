                // the bra-bra sums carried over the ket loop; the pairs with a ket centre
                // added now
                sAA_xx = (sAA_xx + hAA_xx);
                sAA_xy = (sAA_xy + hAA_xy);
                sAA_xz = (sAA_xz + hAA_xz);
