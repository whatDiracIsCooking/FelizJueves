        gB0 = (gB0 + (w0_0_0 * (uYH1_0_0__2_0_0__0_0_0__0_0_0 - (1.0 * dYH1_0_0__0_0_0__0_0_0__0_0_0))));
        gB1 = (gB1 + (w0_0_0 * uYH1_0_0__1_1_0__0_0_0__0_0_0));
        gB2 = (gB2 + (w0_0_0 * uYH1_0_0__1_0_1__0_0_0__0_0_0));
        gC0 = (gC0 + (w0_0_0 * uCH1_0_0__1_0_0__1_0_0__0_0_0));
        gC1 = (gC1 + (w0_0_0 * uCH1_0_0__1_0_0__0_1_0__0_0_0));
        gC2 = (gC2 + (w0_0_0 * uCH1_0_0__1_0_0__0_0_1__0_0_0));
        gA0 = (gA0 + (w0_1_0 * (uXH2_0_0__0_1_0__0_0_0__0_0_0 - (1.0 * dXH0_0_0__0_1_0__0_0_0__0_0_0))));
        gA1 = (gA1 + (w0_1_0 * uXH1_1_0__0_1_0__0_0_0__0_0_0));
        gA2 = (gA2 + (w0_1_0 * uXH1_0_1__0_1_0__0_0_0__0_0_0));
        gB0 = (gB0 + (w0_1_0 * uYH1_0_0__1_1_0__0_0_0__0_0_0));
        gB1 = (gB1 + (w0_1_0 * (uYH1_0_0__0_2_0__0_0_0__0_0_0 - (1.0 * dYH1_0_0__0_0_0__0_0_0__0_0_0))));
        gB2 = (gB2 + (w0_1_0 * uYH1_0_0__0_1_1__0_0_0__0_0_0));
        gC0 = (gC0 + (w0_1_0 * uCH1_0_0__0_1_0__1_0_0__0_0_0));
        gC1 = (gC1 + (w0_1_0 * uCH1_0_0__0_1_0__0_1_0__0_0_0));
        gC2 = (gC2 + (w0_1_0 * uCH1_0_0__0_1_0__0_0_1__0_0_0));
        gA0 = (gA0 + (w0_2_0 * (uXH2_0_0__0_0_1__0_0_0__0_0_0 - (1.0 * dXH0_0_0__0_0_1__0_0_0__0_0_0))));
        gA1 = (gA1 + (w0_2_0 * uXH1_1_0__0_0_1__0_0_0__0_0_0));
        gA2 = (gA2 + (w0_2_0 * uXH1_0_1__0_0_1__0_0_0__0_0_0));
        gB0 = (gB0 + (w0_2_0 * uYH1_0_0__1_0_1__0_0_0__0_0_0));
        gB1 = (gB1 + (w0_2_0 * uYH1_0_0__0_1_1__0_0_0__0_0_0));
        gB2 = (gB2 + (w0_2_0 * (uYH1_0_0__0_0_2__0_0_0__0_0_0 - (1.0 * dYH1_0_0__0_0_0__0_0_0__0_0_0))));
        gC0 = (gC0 + (w0_2_0 * uCH1_0_0__0_0_1__1_0_0__0_0_0));
        gC1 = (gC1 + (w0_2_0 * uCH1_0_0__0_0_1__0_1_0__0_0_0));
        gC2 = (gC2 + (w0_2_0 * uCH1_0_0__0_0_1__0_0_1__0_0_0));
        gA0 = (gA0 + (w1_0_0 * uXH1_1_0__1_0_0__0_0_0__0_0_0));
        gA1 = (gA1 + (w1_0_0 * (uXH0_2_0__1_0_0__0_0_0__0_0_0 - (1.0 * dXH0_0_0__1_0_0__0_0_0__0_0_0))));
        gA2 = (gA2 + (w1_0_0 * uXH0_1_1__1_0_0__0_0_0__0_0_0));
        gB0 = (gB0 + (w1_0_0 * (uYH0_1_0__2_0_0__0_0_0__0_0_0 - (1.0 * dYH0_1_0__0_0_0__0_0_0__0_0_0))));
        gB1 = (gB1 + (w1_0_0 * uYH0_1_0__1_1_0__0_0_0__0_0_0));
        gB2 = (gB2 + (w1_0_0 * uYH0_1_0__1_0_1__0_0_0__0_0_0));
        gC0 = (gC0 + (w1_0_0 * uCH0_1_0__1_0_0__1_0_0__0_0_0));
        gC1 = (gC1 + (w1_0_0 * uCH0_1_0__1_0_0__0_1_0__0_0_0));
        gC2 = (gC2 + (w1_0_0 * uCH0_1_0__1_0_0__0_0_1__0_0_0));
        gA0 = (gA0 + (w1_1_0 * uXH1_1_0__0_1_0__0_0_0__0_0_0));
        gA1 = (gA1 + (w1_1_0 * (uXH0_2_0__0_1_0__0_0_0__0_0_0 - (1.0 * dXH0_0_0__0_1_0__0_0_0__0_0_0))));
        gA2 = (gA2 + (w1_1_0 * uXH0_1_1__0_1_0__0_0_0__0_0_0));
        gB0 = (gB0 + (w1_1_0 * uYH0_1_0__1_1_0__0_0_0__0_0_0));
        gB1 = (gB1 + (w1_1_0 * (uYH0_1_0__0_2_0__0_0_0__0_0_0 - (1.0 * dYH0_1_0__0_0_0__0_0_0__0_0_0))));
        gB2 = (gB2 + (w1_1_0 * uYH0_1_0__0_1_1__0_0_0__0_0_0));
        gC0 = (gC0 + (w1_1_0 * uCH0_1_0__0_1_0__1_0_0__0_0_0));
        gC1 = (gC1 + (w1_1_0 * uCH0_1_0__0_1_0__0_1_0__0_0_0));
        gC2 = (gC2 + (w1_1_0 * uCH0_1_0__0_1_0__0_0_1__0_0_0));
        gA0 = (gA0 + (w1_2_0 * uXH1_1_0__0_0_1__0_0_0__0_0_0));
        gA1 = (gA1 + (w1_2_0 * (uXH0_2_0__0_0_1__0_0_0__0_0_0 - (1.0 * dXH0_0_0__0_0_1__0_0_0__0_0_0))));
        gA2 = (gA2 + (w1_2_0 * uXH0_1_1__0_0_1__0_0_0__0_0_0));
        gB0 = (gB0 + (w1_2_0 * uYH0_1_0__1_0_1__0_0_0__0_0_0));
        gB1 = (gB1 + (w1_2_0 * uYH0_1_0__0_1_1__0_0_0__0_0_0));
        gB2 = (gB2 + (w1_2_0 * (uYH0_1_0__0_0_2__0_0_0__0_0_0 - (1.0 * dYH0_1_0__0_0_0__0_0_0__0_0_0))));
        gC0 = (gC0 + (w1_2_0 * uCH0_1_0__0_0_1__1_0_0__0_0_0));
        gC1 = (gC1 + (w1_2_0 * uCH0_1_0__0_0_1__0_1_0__0_0_0));
        gC2 = (gC2 + (w1_2_0 * uCH0_1_0__0_0_1__0_0_1__0_0_0));
        gA0 = (gA0 + (w2_0_0 * uXH1_0_1__1_0_0__0_0_0__0_0_0));
        gA1 = (gA1 + (w2_0_0 * uXH0_1_1__1_0_0__0_0_0__0_0_0));
        gA2 = (gA2 + (w2_0_0 * (uXH0_0_2__1_0_0__0_0_0__0_0_0 - (1.0 * dXH0_0_0__1_0_0__0_0_0__0_0_0))));
        gB0 = (gB0 + (w2_0_0 * (uYH0_0_1__2_0_0__0_0_0__0_0_0 - (1.0 * dYH0_0_1__0_0_0__0_0_0__0_0_0))));
        gB1 = (gB1 + (w2_0_0 * uYH0_0_1__1_1_0__0_0_0__0_0_0));
        gB2 = (gB2 + (w2_0_0 * uYH0_0_1__1_0_1__0_0_0__0_0_0));
        gC0 = (gC0 + (w2_0_0 * uCH0_0_1__1_0_0__1_0_0__0_0_0));
        gC1 = (gC1 + (w2_0_0 * uCH0_0_1__1_0_0__0_1_0__0_0_0));
        gC2 = (gC2 + (w2_0_0 * uCH0_0_1__1_0_0__0_0_1__0_0_0));
        gA0 = (gA0 + (w2_1_0 * uXH1_0_1__0_1_0__0_0_0__0_0_0));
        gA1 = (gA1 + (w2_1_0 * uXH0_1_1__0_1_0__0_0_0__0_0_0));
        gA2 = (gA2 + (w2_1_0 * (uXH0_0_2__0_1_0__0_0_0__0_0_0 - (1.0 * dXH0_0_0__0_1_0__0_0_0__0_0_0))));
        gB0 = (gB0 + (w2_1_0 * uYH0_0_1__1_1_0__0_0_0__0_0_0));
        gB1 = (gB1 + (w2_1_0 * (uYH0_0_1__0_2_0__0_0_0__0_0_0 - (1.0 * dYH0_0_1__0_0_0__0_0_0__0_0_0))));
        gB2 = (gB2 + (w2_1_0 * uYH0_0_1__0_1_1__0_0_0__0_0_0));
        gC0 = (gC0 + (w2_1_0 * uCH0_0_1__0_1_0__1_0_0__0_0_0));
        gC1 = (gC1 + (w2_1_0 * uCH0_0_1__0_1_0__0_1_0__0_0_0));
        gC2 = (gC2 + (w2_1_0 * uCH0_0_1__0_1_0__0_0_1__0_0_0));
        gA0 = (gA0 + (w2_2_0 * uXH1_0_1__0_0_1__0_0_0__0_0_0));
        gA1 = (gA1 + (w2_2_0 * uXH0_1_1__0_0_1__0_0_0__0_0_0));
        gA2 = (gA2 + (w2_2_0 * (uXH0_0_2__0_0_1__0_0_0__0_0_0 - (1.0 * dXH0_0_0__0_0_1__0_0_0__0_0_0))));
        gB0 = (gB0 + (w2_2_0 * uYH0_0_1__1_0_1__0_0_0__0_0_0));
        gB1 = (gB1 + (w2_2_0 * uYH0_0_1__0_1_1__0_0_0__0_0_0));
        gB2 = (gB2 + (w2_2_0 * (uYH0_0_1__0_0_2__0_0_0__0_0_0 - (1.0 * dYH0_0_1__0_0_0__0_0_0__0_0_0))));
        gC0 = (gC0 + (w2_2_0 * uCH0_0_1__0_0_1__1_0_0__0_0_0));
        gC1 = (gC1 + (w2_2_0 * uCH0_0_1__0_0_1__0_1_0__0_0_0));
        gC2 = (gC2 + (w2_2_0 * uCH0_0_1__0_0_1__0_0_1__0_0_0));
        // AtomicAdd: every record of every pair on an atom adds into that atom's row
        // of G
        atomicAdd(&G[(aa * 3 + 0)], gA0);
        atomicAdd(&G[(aa * 3 + 1)], gA1);
        atomicAdd(&G[(aa * 3 + 2)], gA2);
        atomicAdd(&G[(ab * 3 + 0)], gB0);
        atomicAdd(&G[(ab * 3 + 1)], gB1);
        atomicAdd(&G[(ab * 3 + 2)], gB2);
        atomicAdd(&G[(ap * 3 + 0)], gC0);
        atomicAdd(&G[(ap * 3 + 1)], gC1);
        atomicAdd(&G[(ap * 3 + 2)], gC2);
    }
}
