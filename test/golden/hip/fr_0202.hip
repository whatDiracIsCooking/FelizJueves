                    f_ab_0_3 = (f_ab_0_3 + (w_cd_0_5 * H0_0_0__0_2_0__0_0_0__0_0_2));
                    f_cd_0_5 = (f_cd_0_5 + (w_ab_0_3 * H0_0_0__0_2_0__0_0_0__0_0_2));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_3_5 * H0_0_0__0_2_0__0_0_0__0_0_2));
                    f_ad_0_5 = (f_ad_0_5 + (w_bc_3_0 * H0_0_0__0_2_0__0_0_0__0_0_2));
                    f_bc_3_0 = (f_bc_3_0 + (w_ad_0_5 * H0_0_0__0_2_0__0_0_0__0_0_2));
                    f_bd_3_5 = (f_bd_3_5 + (w_ac_0_0 * H0_0_0__0_2_0__0_0_0__0_0_2));
                    f_ab_0_4 = (f_ab_0_4 + (w_cd_0_0 * H0_0_0__0_1_1__0_0_0__2_0_0));
                    f_cd_0_0 = (f_cd_0_0 + (w_ab_0_4 * H0_0_0__0_1_1__0_0_0__2_0_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_4_0 * H0_0_0__0_1_1__0_0_0__2_0_0));
                    f_ad_0_0 = (f_ad_0_0 + (w_bc_4_0 * H0_0_0__0_1_1__0_0_0__2_0_0));
                    f_bc_4_0 = (f_bc_4_0 + (w_ad_0_0 * H0_0_0__0_1_1__0_0_0__2_0_0));
                    f_bd_4_0 = (f_bd_4_0 + (w_ac_0_0 * H0_0_0__0_1_1__0_0_0__2_0_0));
                    f_ab_0_4 = (f_ab_0_4 + (w_cd_0_1 * H0_0_0__0_1_1__0_0_0__1_1_0));
                    f_cd_0_1 = (f_cd_0_1 + (w_ab_0_4 * H0_0_0__0_1_1__0_0_0__1_1_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_4_1 * H0_0_0__0_1_1__0_0_0__1_1_0));
                    f_ad_0_1 = (f_ad_0_1 + (w_bc_4_0 * H0_0_0__0_1_1__0_0_0__1_1_0));
                    f_bc_4_0 = (f_bc_4_0 + (w_ad_0_1 * H0_0_0__0_1_1__0_0_0__1_1_0));
                    f_bd_4_1 = (f_bd_4_1 + (w_ac_0_0 * H0_0_0__0_1_1__0_0_0__1_1_0));
                    f_ab_0_4 = (f_ab_0_4 + (w_cd_0_2 * H0_0_0__0_1_1__0_0_0__1_0_1));
                    f_cd_0_2 = (f_cd_0_2 + (w_ab_0_4 * H0_0_0__0_1_1__0_0_0__1_0_1));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_4_2 * H0_0_0__0_1_1__0_0_0__1_0_1));
                    f_ad_0_2 = (f_ad_0_2 + (w_bc_4_0 * H0_0_0__0_1_1__0_0_0__1_0_1));
                    f_bc_4_0 = (f_bc_4_0 + (w_ad_0_2 * H0_0_0__0_1_1__0_0_0__1_0_1));
                    f_bd_4_2 = (f_bd_4_2 + (w_ac_0_0 * H0_0_0__0_1_1__0_0_0__1_0_1));
                    f_ab_0_4 = (f_ab_0_4 + (w_cd_0_3 * H0_0_0__0_1_1__0_0_0__0_2_0));
                    f_cd_0_3 = (f_cd_0_3 + (w_ab_0_4 * H0_0_0__0_1_1__0_0_0__0_2_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_4_3 * H0_0_0__0_1_1__0_0_0__0_2_0));
                    f_ad_0_3 = (f_ad_0_3 + (w_bc_4_0 * H0_0_0__0_1_1__0_0_0__0_2_0));
                    f_bc_4_0 = (f_bc_4_0 + (w_ad_0_3 * H0_0_0__0_1_1__0_0_0__0_2_0));
                    f_bd_4_3 = (f_bd_4_3 + (w_ac_0_0 * H0_0_0__0_1_1__0_0_0__0_2_0));
                    f_ab_0_4 = (f_ab_0_4 + (w_cd_0_4 * H0_0_0__0_1_1__0_0_0__0_1_1));
                    f_cd_0_4 = (f_cd_0_4 + (w_ab_0_4 * H0_0_0__0_1_1__0_0_0__0_1_1));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_4_4 * H0_0_0__0_1_1__0_0_0__0_1_1));
                    f_ad_0_4 = (f_ad_0_4 + (w_bc_4_0 * H0_0_0__0_1_1__0_0_0__0_1_1));
                    f_bc_4_0 = (f_bc_4_0 + (w_ad_0_4 * H0_0_0__0_1_1__0_0_0__0_1_1));
                    f_bd_4_4 = (f_bd_4_4 + (w_ac_0_0 * H0_0_0__0_1_1__0_0_0__0_1_1));
                    f_ab_0_4 = (f_ab_0_4 + (w_cd_0_5 * H0_0_0__0_1_1__0_0_0__0_0_2));
                    f_cd_0_5 = (f_cd_0_5 + (w_ab_0_4 * H0_0_0__0_1_1__0_0_0__0_0_2));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_4_5 * H0_0_0__0_1_1__0_0_0__0_0_2));
                    f_ad_0_5 = (f_ad_0_5 + (w_bc_4_0 * H0_0_0__0_1_1__0_0_0__0_0_2));
                    f_bc_4_0 = (f_bc_4_0 + (w_ad_0_5 * H0_0_0__0_1_1__0_0_0__0_0_2));
                    f_bd_4_5 = (f_bd_4_5 + (w_ac_0_0 * H0_0_0__0_1_1__0_0_0__0_0_2));
                    f_ab_0_5 = (f_ab_0_5 + (w_cd_0_0 * H0_0_0__0_0_2__0_0_0__2_0_0));
                    f_cd_0_0 = (f_cd_0_0 + (w_ab_0_5 * H0_0_0__0_0_2__0_0_0__2_0_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_5_0 * H0_0_0__0_0_2__0_0_0__2_0_0));
                    f_ad_0_0 = (f_ad_0_0 + (w_bc_5_0 * H0_0_0__0_0_2__0_0_0__2_0_0));
                    f_bc_5_0 = (f_bc_5_0 + (w_ad_0_0 * H0_0_0__0_0_2__0_0_0__2_0_0));
                    f_bd_5_0 = (f_bd_5_0 + (w_ac_0_0 * H0_0_0__0_0_2__0_0_0__2_0_0));
                    f_ab_0_5 = (f_ab_0_5 + (w_cd_0_1 * H0_0_0__0_0_2__0_0_0__1_1_0));
                    f_cd_0_1 = (f_cd_0_1 + (w_ab_0_5 * H0_0_0__0_0_2__0_0_0__1_1_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_5_1 * H0_0_0__0_0_2__0_0_0__1_1_0));
                    f_ad_0_1 = (f_ad_0_1 + (w_bc_5_0 * H0_0_0__0_0_2__0_0_0__1_1_0));
                    f_bc_5_0 = (f_bc_5_0 + (w_ad_0_1 * H0_0_0__0_0_2__0_0_0__1_1_0));
                    f_bd_5_1 = (f_bd_5_1 + (w_ac_0_0 * H0_0_0__0_0_2__0_0_0__1_1_0));
                    f_ab_0_5 = (f_ab_0_5 + (w_cd_0_2 * H0_0_0__0_0_2__0_0_0__1_0_1));
                    f_cd_0_2 = (f_cd_0_2 + (w_ab_0_5 * H0_0_0__0_0_2__0_0_0__1_0_1));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_5_2 * H0_0_0__0_0_2__0_0_0__1_0_1));
                    f_ad_0_2 = (f_ad_0_2 + (w_bc_5_0 * H0_0_0__0_0_2__0_0_0__1_0_1));
                    f_bc_5_0 = (f_bc_5_0 + (w_ad_0_2 * H0_0_0__0_0_2__0_0_0__1_0_1));
                    f_bd_5_2 = (f_bd_5_2 + (w_ac_0_0 * H0_0_0__0_0_2__0_0_0__1_0_1));
                    f_ab_0_5 = (f_ab_0_5 + (w_cd_0_3 * H0_0_0__0_0_2__0_0_0__0_2_0));
                    f_cd_0_3 = (f_cd_0_3 + (w_ab_0_5 * H0_0_0__0_0_2__0_0_0__0_2_0));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_5_3 * H0_0_0__0_0_2__0_0_0__0_2_0));
                    f_ad_0_3 = (f_ad_0_3 + (w_bc_5_0 * H0_0_0__0_0_2__0_0_0__0_2_0));
                    f_bc_5_0 = (f_bc_5_0 + (w_ad_0_3 * H0_0_0__0_0_2__0_0_0__0_2_0));
                    f_bd_5_3 = (f_bd_5_3 + (w_ac_0_0 * H0_0_0__0_0_2__0_0_0__0_2_0));
                    f_ab_0_5 = (f_ab_0_5 + (w_cd_0_4 * H0_0_0__0_0_2__0_0_0__0_1_1));
                    f_cd_0_4 = (f_cd_0_4 + (w_ab_0_5 * H0_0_0__0_0_2__0_0_0__0_1_1));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_5_4 * H0_0_0__0_0_2__0_0_0__0_1_1));
                    f_ad_0_4 = (f_ad_0_4 + (w_bc_5_0 * H0_0_0__0_0_2__0_0_0__0_1_1));
                    f_bc_5_0 = (f_bc_5_0 + (w_ad_0_4 * H0_0_0__0_0_2__0_0_0__0_1_1));
                    f_bd_5_4 = (f_bd_5_4 + (w_ac_0_0 * H0_0_0__0_0_2__0_0_0__0_1_1));
                    f_ab_0_5 = (f_ab_0_5 + (w_cd_0_5 * H0_0_0__0_0_2__0_0_0__0_0_2));
                    f_cd_0_5 = (f_cd_0_5 + (w_ab_0_5 * H0_0_0__0_0_2__0_0_0__0_0_2));
                    f_ac_0_0 = (f_ac_0_0 + (w_bd_5_5 * H0_0_0__0_0_2__0_0_0__0_0_2));
                    f_ad_0_5 = (f_ad_0_5 + (w_bc_5_0 * H0_0_0__0_0_2__0_0_0__0_0_2));
                    f_bc_5_0 = (f_bc_5_0 + (w_ad_0_5 * H0_0_0__0_0_2__0_0_0__0_0_2));
                    f_bd_5_5 = (f_bd_5_5 + (w_ac_0_0 * H0_0_0__0_0_2__0_0_0__0_0_2));
                    // flush the five ket-dependent buffers: AtomicAdd, the only atomics besides
                    // f_ab's one flush
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 0))], f_cd_0_0);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 1))], f_cd_0_1);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 2))], f_cd_0_2);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 3))], f_cd_0_3);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 4))], f_cd_0_4);
                    atomicAdd(&F[((oc + 0) * n_ao + (od + 5))], f_cd_0_5);
                    atomicAdd(&F[((oa + 0) * n_ao + (oc + 0))], f_ac_0_0);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 0))], f_ad_0_0);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 1))], f_ad_0_1);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 2))], f_ad_0_2);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 3))], f_ad_0_3);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 4))], f_ad_0_4);
                    atomicAdd(&F[((oa + 0) * n_ao + (od + 5))], f_ad_0_5);
                    atomicAdd(&F[((ob + 0) * n_ao + (oc + 0))], f_bc_0_0);
                    atomicAdd(&F[((ob + 1) * n_ao + (oc + 0))], f_bc_1_0);
                    atomicAdd(&F[((ob + 2) * n_ao + (oc + 0))], f_bc_2_0);
                    atomicAdd(&F[((ob + 3) * n_ao + (oc + 0))], f_bc_3_0);
                    atomicAdd(&F[((ob + 4) * n_ao + (oc + 0))], f_bc_4_0);
                    atomicAdd(&F[((ob + 5) * n_ao + (oc + 0))], f_bc_5_0);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 0))], f_bd_0_0);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 1))], f_bd_0_1);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 2))], f_bd_0_2);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 3))], f_bd_0_3);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 4))], f_bd_0_4);
                    atomicAdd(&F[((ob + 0) * n_ao + (od + 5))], f_bd_0_5);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 0))], f_bd_1_0);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 1))], f_bd_1_1);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 2))], f_bd_1_2);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 3))], f_bd_1_3);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 4))], f_bd_1_4);
                    atomicAdd(&F[((ob + 1) * n_ao + (od + 5))], f_bd_1_5);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 0))], f_bd_2_0);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 1))], f_bd_2_1);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 2))], f_bd_2_2);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 3))], f_bd_2_3);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 4))], f_bd_2_4);
                    atomicAdd(&F[((ob + 2) * n_ao + (od + 5))], f_bd_2_5);
                    atomicAdd(&F[((ob + 3) * n_ao + (od + 0))], f_bd_3_0);
                    atomicAdd(&F[((ob + 3) * n_ao + (od + 1))], f_bd_3_1);
                    atomicAdd(&F[((ob + 3) * n_ao + (od + 2))], f_bd_3_2);
                    atomicAdd(&F[((ob + 3) * n_ao + (od + 3))], f_bd_3_3);
                    atomicAdd(&F[((ob + 3) * n_ao + (od + 4))], f_bd_3_4);
                    atomicAdd(&F[((ob + 3) * n_ao + (od + 5))], f_bd_3_5);
                    atomicAdd(&F[((ob + 4) * n_ao + (od + 0))], f_bd_4_0);
                    atomicAdd(&F[((ob + 4) * n_ao + (od + 1))], f_bd_4_1);
                    atomicAdd(&F[((ob + 4) * n_ao + (od + 2))], f_bd_4_2);
                    atomicAdd(&F[((ob + 4) * n_ao + (od + 3))], f_bd_4_3);
                    atomicAdd(&F[((ob + 4) * n_ao + (od + 4))], f_bd_4_4);
                    atomicAdd(&F[((ob + 4) * n_ao + (od + 5))], f_bd_4_5);
                    atomicAdd(&F[((ob + 5) * n_ao + (od + 0))], f_bd_5_0);
                    atomicAdd(&F[((ob + 5) * n_ao + (od + 1))], f_bd_5_1);
                    atomicAdd(&F[((ob + 5) * n_ao + (od + 2))], f_bd_5_2);
                    atomicAdd(&F[((ob + 5) * n_ao + (od + 3))], f_bd_5_3);
                    atomicAdd(&F[((ob + 5) * n_ao + (od + 4))], f_bd_5_4);
                    atomicAdd(&F[((ob + 5) * n_ao + (od + 5))], f_bd_5_5);
                }
            }
        }
        // flush f_ab: once per thread, after its whole ket loop
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 0))], f_ab_0_0);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 1))], f_ab_0_1);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 2))], f_ab_0_2);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 3))], f_ab_0_3);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 4))], f_ab_0_4);
        atomicAdd(&F[((oa + 0) * n_ao + (ob + 5))], f_ab_0_5);
    }
}
