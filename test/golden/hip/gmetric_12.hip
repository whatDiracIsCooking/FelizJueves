            F[m] = f;
        }
        return;
    }
    double term = 1.0 / (double)(2 * M + 1);
    double sum = term;
    for (int k = 1; k < 4096; ++k) {
        term = term * ((2.0 * T) / (double)(2 * M + 2 * k + 1));
        double next = sum + term;
        if (next == sum) {
            break;
        }
        sum = next;
    }
    double f = e * sum;
    F[M] = f;
#pragma unroll
    for (int m = M - 1; m >= 0; --m) {
        f = (2.0 * T * f + e) * (1.0 / (double)(2 * m + 1));
        F[m] = f;
    }
}

